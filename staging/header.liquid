<style>
/* ============================================
   NA CUSTOM HEADER
   ============================================ */
.header-wrapper {
  position: fixed !important; top: 0 !important; left: 0; right: 0;
  z-index: 100; background: transparent !important; border-bottom: none !important;
  transition: background 0.35s ease, box-shadow 0.35s ease;
}
.header-wrapper.scrolled {
  background: #fff !important;
  box-shadow: 0 1px 0 rgba(0,0,0,0.08) !important;
}
.shopify-section-group-header-group { height: 0 !important; overflow: visible !important; }
.na-header-main {
  display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
  padding: 12px 40px !important; height: auto !important; max-width: 1700px;
  margin: 0 auto; width: 100%; box-sizing: border-box;
}
.na-header-left { display: flex; align-items: center; gap: 4px; }
.na-burger {
  width: 38px; height: 38px; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 5px; cursor: pointer;
  border-radius: 6px; border: none; background: transparent; padding: 0;
  transition: background 0.2s; flex-shrink: 0;
}
.na-burger:hover { background: rgba(255,255,255,0.1); }
.header-wrapper.scrolled .na-burger:hover { background: rgba(0,0,0,0.06); }
.na-burger-line {
  width: 20px; height: 1.5px; background: rgba(255,255,255,0.9); border-radius: 2px;
  transition: background 0.35s, transform 0.28s cubic-bezier(0.4,0,0.2,1), opacity 0.2s;
  transform-origin: center; display: block;
}
.header-wrapper.scrolled .na-burger-line { background: #111; }
.na-burger.open .na-burger-line:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.na-burger.open .na-burger-line:nth-child(2) { opacity: 0; transform: scaleX(0); }
.na-burger.open .na-burger-line:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
.na-explore-link {
  font-size: 12px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase;
  color: rgba(255,255,255,0.9); text-decoration: none; padding: 8px 12px;
  border-radius: 5px; white-space: nowrap; transition: color 0.2s, background 0.2s;
}
.na-explore-link:hover { color: #fff; background: rgba(255,255,255,0.1); }
.header-wrapper.scrolled .na-explore-link { color: #111; }
.header-wrapper.scrolled .na-explore-link:hover { background: rgba(0,0,0,0.05); }
.na-logo { justify-self: center; display: flex; align-items: center; text-decoration: none; }
.na-logo img {
  height: 30px; width: auto; max-width: 200px; display: block;
  transition: filter 0.35s; filter: brightness(0) invert(1);
}
.header-wrapper.scrolled .na-logo img { filter: none; }
.na-logo-text {
  font-size: 20px; font-weight: 800; letter-spacing: -0.5px;
  color: #fff; text-decoration: none; white-space: nowrap; transition: color 0.35s;
}
.header-wrapper.scrolled .na-logo-text { color: #000; }
.na-header-right { display: flex; align-items: center; justify-content: flex-end; gap: 4px; }
.na-search-wrap { position: relative; width: 175px; transition: width 0.3s ease; }
.na-search-wrap:focus-within { width: 230px; }
.na-search-input {
  width: 100%; height: 34px; background: rgba(255,255,255,0.11);
  border: 1px solid rgba(255,255,255,0.17); border-radius: 6px;
  padding: 0 34px 0 13px; font-size: 12px; color: #fff; outline: none;
  font-family: inherit; transition: background 0.2s, border-color 0.2s;
}
.na-search-input::placeholder { color: rgba(255,255,255,0.38); }
.na-search-input:focus { background: rgba(255,255,255,0.17); border-color: rgba(255,255,255,0.32); }
.header-wrapper.scrolled .na-search-input { background: #f4f4f0; border-color: #e0e0da; color: #000; }
.header-wrapper.scrolled .na-search-input::placeholder { color: rgba(0,0,0,0.33); }
.na-search-icon {
  position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
  pointer-events: none; opacity: 0.4; color: #fff; transition: filter 0.35s;
}
.header-wrapper.scrolled .na-search-icon { filter: invert(1); }
.na-icon-btn {
  width: 34px; height: 34px; display: flex; align-items: center; justify-content: center;
  border-radius: 6px; cursor: pointer; background: transparent; border: none; padding: 0;
  transition: background 0.2s; position: relative; flex-shrink: 0; text-decoration: none;
}
.na-icon-btn:hover { background: rgba(255,255,255,0.1); }
.header-wrapper.scrolled .na-icon-btn:hover { background: rgba(0,0,0,0.06); }
.na-icon-btn svg { stroke: rgba(255,255,255,0.9); transition: stroke 0.35s; display: block; }
.header-wrapper.scrolled .na-icon-btn svg { stroke: #111; }
.na-cart-count {
  position: absolute; top: 3px; right: 3px; width: 15px; height: 15px;
  background: #fff; color: #000; font-size: 8px; font-weight: 700; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.35s, color 0.35s; font-family: inherit;
}
.header-wrapper.scrolled .na-cart-count { background: #000; color: #fff; }
#naHeaderWrapper[data-static] { background: #fff !important; box-shadow: 0 1px 0 rgba(0,0,0,0.08) !important; }
#naHeaderWrapper[data-static] .na-burger-line { background: #111; }
#naHeaderWrapper[data-static] .na-explore-link { color: #111; }
#naHeaderWrapper[data-static] .na-logo img { filter: none; }
#naHeaderWrapper[data-static] .na-logo-text { color: #000; }
#naHeaderWrapper[data-static] .na-icon-btn svg { stroke: #111; }
#naHeaderWrapper[data-static] .na-search-input { background: #f4f4f0; border-color: #e0e0da; color: #000; }
#naHeaderWrapper[data-static] .na-search-input::placeholder { color: rgba(0,0,0,0.33); }
#naHeaderWrapper[data-static] .na-search-icon { filter: invert(1); }
#naHeaderWrapper[data-static] .na-cart-count { background: #000; color: #fff; }
#naHeaderWrapper[data-static] .na-burger:hover { background: rgba(0,0,0,0.06); }
body #MainContent { padding-top: var(--header-offset, 0px) !important; }

/* Mobile search hidden on desktop */
/* Mobile search — visually hidden on desktop but in DOM for Snap Search to bind */
.na-search-mobile {
  position: absolute;
  opacity: 0;
  pointer-events: none;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
}
@media (max-width: 767px) {
 .na-header-main {
padding: 10px 16px 8px !important;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: auto auto;
    grid-template-areas:
      "left logo right"
      "search search search";
row-gap: 8px;
  }
  .na-header-left { grid-area: left; }
  .na-logo { grid-area: logo; justify-self: center; }
  .na-header-right { grid-area: right; }
.na-search-mobile {
    grid-area: search;
    display: block !important;
    position: relative !important;
    width: 100% !important;
    padding-bottom: 2px;
    opacity: 1 !important;
    clip: auto !important;
    height: auto !important;
    overflow: visible !important;
    pointer-events: auto !important;
  }
.na-search-mobile .na-search-input { width: 100%; height: 36px; font-size: 13px; }
  .na-header-right .na-search-wrap { display: none; }
  .na-explore-link { display: none; }
  .na-logo img { height: 24px; }
  .na-logo-text { font-size: 17px; }
  .na-header-right .na-icon-btn[aria-label="Account"] { display: none; }
}
@media (max-width: 380px) { .na-explore-link { display: none; } }

/* ============================================
   DRAWER
   ============================================ */
.na-drawer-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 150;
  opacity: 0; pointer-events: none; transition: opacity 0.35s;
  backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
}
.na-drawer-overlay.open { opacity: 1; pointer-events: all; }
.na-drawer {
  position: fixed; top: 0; left: 0; bottom: 0; width: min(400px, 100vw); background: #fff;
  z-index: 160; transform: translateX(-100%);
  transition: transform 0.4s cubic-bezier(0.4,0,0.2,1);
  display: flex; flex-direction: column; overflow-y: auto;
  font-family: 'Poppins', sans-serif;
}
.na-drawer.open { transform: translateX(0); }
.na-drawer-head {
  display: flex; align-items: center; padding: 16px 28px;
  border-bottom: 1px solid #efefed; flex-shrink: 0; position: relative; min-height: 62px;
}
.na-drawer-head-logo {
  position: absolute; left: 50%; transform: translateX(-50%);
  height: 38px; width: auto; display: block;
}
.na-drawer-close {
  width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;
  cursor: pointer; color: #999; border: 1px solid #e5e5e5; background: transparent;
  border-radius: 50%; padding: 0; font-family: inherit; transition: all 0.15s;
  font-size: 16px; line-height: 1; margin-left: auto;
}
.na-drawer-close:hover { color: #111; border-color: #111; }
.na-drawer-tabs {
  display: flex; border-bottom: 1px solid #efefed; flex-shrink: 0; padding: 0;
}
.na-drawer-tab {
  flex: 1; text-align: center; font-size: 11px; font-weight: 600; letter-spacing: 1px;
  text-transform: uppercase; color: #aaa; padding: 14px 0; margin-right: 0;
  border-bottom: 2px solid transparent; transition: color 0.15s, border-color 0.15s;
  white-space: nowrap; cursor: pointer; background: none; border-top: none;
  border-left: none; border-right: none; font-family: 'Poppins', sans-serif;
}
.na-drawer-tab:hover { color: #111; }
.na-drawer-tab.active { color: #111; border-bottom: 2px solid #111; }
.na-drawer-panel { display: none; flex: 1; flex-direction: column; }
.na-drawer-panel.active { display: flex; flex-direction: column; }
.na-drawer-shop-grid { display: grid; grid-template-columns: 1fr 1fr; flex-shrink: 0; }
.na-drawer-shop-col { padding: 20px 16px 20px 28px; }
.na-drawer-shop-col + .na-drawer-shop-col { padding-left: 16px; border-left: 1px solid #efefed; }
.na-drawer-col-title {
  font-size: 9px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
  color: #888; margin-bottom: 10px; display: block; padding-bottom: 8px; border-bottom: 2px solid #111;
}
.na-drawer-shop-col a {
  display: block; font-size: 13px; font-weight: 500; color: #222;
  text-decoration: none; padding: 5px 0; transition: color 0.12s; letter-spacing: 0.1px;
}
.na-drawer-shop-col a:hover { color: #000; }
.na-drawer-shop-col a.na-sale { color: #cc0000; font-weight: 600; }
.na-drawer-welcome {
  display: flex; align-items: center; gap: 14px;
  margin: 18px 28px 4px; padding: 16px 18px;
  background: #f7f7f5; border: 1px solid #efefed; border-left: 4px solid #111;
  border-radius: 10px; text-decoration: none; transition: background 0.18s, transform 0.18s;
}
.na-drawer-welcome:hover { background: #f0f0ec; transform: translateX(2px); }
.na-drawer-welcome-text { flex: 1; min-width: 0; }
.na-drawer-welcome-eyebrow {
  font-size: 9px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
  color: #999; display: block; margin-bottom: 3px;
}
.na-drawer-welcome-title { font-size: 14px; font-weight: 700; color: #111; line-height: 1.2; margin: 0 0 3px; }
.na-drawer-welcome-sub { font-size: 11px; color: #777; line-height: 1.4; margin: 0; }
.na-drawer-welcome-arrow {
  flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: #111;
  display: flex; align-items: center; justify-content: center; color: #fff;
  font-size: 13px; transition: transform 0.18s;
}
.na-drawer-welcome:hover .na-drawer-welcome-arrow { transform: translateX(2px); }
@media (max-width: 400px) { .na-drawer-welcome { margin: 14px 16px 4px; } }
.na-drawer-trust-block {
  margin: 16px 28px; border: 1px solid #efefed; border-radius: 16px;
  overflow: hidden; flex-shrink: 0; background: #fff;
}
.na-drawer-trust-top {
  display: flex; align-items: center; justify-content: center; gap: 10px;
  padding: 12px 18px; border-bottom: 1px solid #efefed; background: #fafaf9;
}
.na-drawer-trust-stars { display: flex; gap: 3px; }
.na-drawer-trust-star {
  width: 22px; height: 22px; background: #00b67a; display: flex;
  align-items: center; justify-content: center; border-radius: 3px; flex-shrink: 0;
}
.na-drawer-trust-star.half { background: linear-gradient(90deg, #00b67a 50%, #ddd 50%); }
.na-drawer-trust-star svg { width: 12px; height: 12px; fill: #fff; }
.na-drawer-trust-rating-text { font-size: 12px; font-weight: 500; color: #666; white-space: nowrap; }
.na-drawer-trust-stats { display: flex; flex-direction: column; }
.na-drawer-trust-stat {
  display: flex; flex-direction: column; gap: 4px;
  padding: 13px 18px; border-bottom: 1px solid #efefed;
}
.na-drawer-trust-stat:last-child { border-bottom: none; }
.na-drawer-stat-eyebrow {
  font-size: 9px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase;
  display: flex; align-items: center; gap: 5px;
}
.na-drawer-stat-eyebrow.live { color: #e63535; }
.na-drawer-stat-eyebrow.stock { color: #1a9e5c; }
.na-drawer-stat-eyebrow.dispatch { color: #555; }
.na-drawer-live-dot {
  width: 5px; height: 5px; background: #e63535; border-radius: 50%; flex-shrink: 0;
  animation: na-pulse 1.4s ease-in-out infinite;
}
.na-drawer-stock-dot { width: 5px; height: 5px; background: #1a9e5c; border-radius: 50%; flex-shrink: 0; }
@keyframes na-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
.na-drawer-stat-num {
  font-size: 19px; font-weight: 800; color: #111; letter-spacing: -0.02em;
  font-family: 'Poppins', sans-serif; line-height: 1.1;
}
.na-drawer-stat-label { font-size: 10.5px; color: #999; line-height: 1.3; }
.na-drawer-stat-label strong { color: #555; font-weight: 600; }
.na-drawer-help-nudge {
  margin: 16px 28px 0; padding: 12px 16px; background: #f7f7f5; border-radius: 6px;
  border: 1px solid #efefed; font-size: 11.5px; color: #555; line-height: 1.5;
  text-align: center; flex-shrink: 0;
}
.na-drawer-help-nudge strong { color: #111; }
.na-drawer-contact-cta {
  display: block; margin: 10px 28px 20px; padding: 14px 20px;
  background: #111; color: #fff; text-decoration: none;
  font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
  text-align: center; border-radius: 4px; transition: background 0.2s;
  font-family: 'Poppins', sans-serif; flex-shrink: 0;
}
.na-drawer-contact-cta:hover { background: #333; color: #fff; }
.na-drawer-info-links { padding: 8px 0; flex: 1; }
.na-drawer-info-links a {
  display: flex; align-items: center; justify-content: space-between;
  padding: 13px 28px; font-size: 13px; font-weight: 400; color: #333;
  text-decoration: none; border-bottom: 1px solid #f5f5f3;
  transition: background 0.12s, color 0.12s;
}
.na-drawer-info-links a:hover { background: #f7f7f5; color: #111; }
.na-drawer-info-arrow { font-size: 10px; color: #ccc; }
.na-currency-wrap { padding: 16px 28px; border-top: 1px solid #f5f5f3; }
.na-currency-label {
  font-size: 10px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
  color: #bbb; display: block; margin-bottom: 8px;
}
.na-currency-select {
  width: 100%; padding: 10px 14px; font-size: 13px; font-family: 'Poppins', sans-serif;
  border: 1px solid #e5e5e5; border-radius: 4px; color: #111; background: #fff;
  cursor: pointer; appearance: auto;
}
.na-drawer-footer { margin-top: auto; padding: 28px 28px 40px; border-top: 1px solid #efefed; flex-shrink: 0; }
.na-drawer-footer-tagline {
  font-size: 12px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;
  color: #111; margin-bottom: 18px; line-height: 1.4;
}
.na-drawer-socials { display: flex; gap: 10px; align-items: center; margin-bottom: 22px; }
.na-drawer-social {
  width: 36px; height: 36px; border-radius: 50%; background: #111;
  display: flex; align-items: center; justify-content: center;
  text-decoration: none; transition: background 0.2s;
}
.na-drawer-social:hover { background: #444; }
.na-drawer-social svg { width: 16px; height: 16px; fill: #fff; }
.na-drawer-footer-links { display: flex; flex-wrap: wrap; gap: 4px 14px; }
.na-drawer-footer-links a {
  font-size: 10px; color: #bbb; text-decoration: none;
  transition: color 0.15s; text-transform: uppercase; letter-spacing: 0.5px;
}
.na-drawer-footer-links a:hover { color: #333; }
@media (max-width: 400px) {
  .na-drawer-trust-block { margin: 14px 16px; }
  .na-drawer-help-nudge { margin: 12px 16px 0; }
  .na-drawer-contact-cta { margin: 10px 16px 16px; }
}
@media (max-width: 360px) {
  .na-drawer-shop-grid { grid-template-columns: 1fr; }
  .na-drawer-shop-col + .na-drawer-shop-col { border-left: none; border-top: 1px solid #efefed; padding-left: 28px; }
}
kaching-cart div.kaching-cart:not(.active) { display: none !important; }
.cart-count-bubble { display: none !important; }
cart-notification, .cart-notification { display: none !important; }
.kaching-cart-button, [class*="kaching-cart-button"], kaching-cart-button { display: none !important; }
#kaching-cart:not(.active) { display: none !important; }
</style>

