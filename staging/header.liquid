<!-- HEADER -->
<header class="header-wrapper color-background-1 gradient" id="naHeaderWrapper">
  <div class="na-header-main">
    <div class="na-header-left">
      <button class="na-burger" id="naBurger" onclick="naToggleDrawer()" aria-label="Open menu" aria-expanded="false">
        <span class="na-burger-line"></span>
        <span class="na-burger-line"></span>
        <span class="na-burger-line"></span>
      </button>
      <a href="/collections/all-products" class="na-explore-link">Explore Vintage</a>
    </div>
    <a href="/" class="na-logo" aria-label="{{ shop.name }}">
      {%- if logo != blank -%}
        <img src="{{ logo | image_url: width: 300 }}" alt="{{ logo_alt }}" width="{{ logo.width }}" height="{{ logo.height }}" loading="eager">
      {%- else -%}
        <span class="na-logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>
    <div class="na-header-right">
      <form action="/search" method="get" class="na-search-wrap" role="search">
        <input class="na-search-input" type="search" name="q" placeholder="Search..." aria-label="Search" autocomplete="off">
        <svg class="na-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </form>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}/account{%- else -%}/account/login{%- endif -%}" class="na-icon-btn" aria-label="Account">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke-width="1.8" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="na-icon-btn" id="cart-icon-bubble" aria-label="Cart">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke-width="1.8" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="na-cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
    <form action="/search" method="get" class="na-search-mobile" role="search">
      <input class="na-search-input" type="search" name="q" placeholder="Search..." aria-label="Search" autocomplete="off">
      <svg class="na-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
    </form>
  </div>
</header>

<script>
(function() {
    var hw = document.getElementById('naHeaderWrapper');
    var isHome = window.location.pathname === '/' || window.location.pathname === '';
    if (!isHome) {
      hw.setAttribute('data-static', 'true');
      function setOffset() {
        var h = hw.offsetHeight;
        document.documentElement.style.setProperty('--header-offset', h + 'px');
      }
      setTimeout(setOffset, 50);
      window.addEventListener('resize', setOffset);
    } else {
      document.documentElement.style.setProperty('--header-offset', '0px');
    }
    function onScroll() { hw.classList.toggle('scrolled', window.scrollY > 50); }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();

  function naInitCart() {
    var cartBtn = document.getElementById('cart-icon-bubble');
    if (cartBtn && !cartBtn._kachingBound) {
      cartBtn._kachingBound = true;
      cartBtn.addEventListener('click', function(e) {
        e.preventDefault();
        if (window.kachingCartApi) {
          window.kachingCartApi.refreshCart();
          window.kachingCartApi.openCart();
        }
      });
    }
    var cd = document.querySelector('cart-drawer');
    if (cd && !cd._kachingPatched) {
      cd._kachingPatched = true;
      cd.open = function() {
        if (window.kachingCartApi) {
          window.kachingCartApi.refreshCart();
          window.kachingCartApi.openCart();
        }
      };
      cd.renderContents = function() {
        if (window.kachingCartApi) window.kachingCartApi.refreshCart();
        fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
          var el = document.querySelector('.na-cart-count');
          if (el) {
            el.textContent = cart.item_count;
            el.style.display = cart.item_count > 0 ? 'flex' : 'none';
          }
        });
      };
    }
    function attachSlideObserver() {
      var inner = document.querySelector('kaching-cart-drawer');
      if (inner && !inner._slidePatched) {
        inner._slidePatched = true;
        var slideObs = new MutationObserver(function(mutations) {
          mutations.forEach(function(m) {
            if (m.attributeName !== 'open') return;
            var isOpen = inner.getAttribute('open') === 'true';
            if (isOpen) {
              inner.style.setProperty('transform', 'translateX(110%)', 'important');
              inner.style.setProperty('transition', 'none', 'important');
              requestAnimationFrame(function() {
                requestAnimationFrame(function() {
                  inner.style.setProperty('transition', 'transform 0.45s cubic-bezier(0.4,0,0.2,1)', 'important');
                  inner.style.setProperty('transform', 'translateX(0)', 'important');
                });
              });
            } else {
              inner.style.setProperty('transition', 'transform 0.45s cubic-bezier(0.4,0,0.2,1)', 'important');
              inner.style.setProperty('transform', 'translateX(110%)', 'important');
              setTimeout(function() {
                inner.style.removeProperty('transform');
                inner.style.removeProperty('transition');
              }, 460);
            }
          });
        });
        slideObs.observe(inner, { attributes: true, attributeFilter: ['open'] });
        return true;
      }
      return false;
    }
    if (!attachSlideObserver()) {
      var domObs = new MutationObserver(function() {
        if (attachSlideObserver()) domObs.disconnect();
      });
      domObs.observe(document.body, { childList: true, subtree: true });
    }
    var rawCount = {{ shop.orders_count | default: 0 }};
    var orderEl = document.getElementById('naOrderCount');
    if (orderEl && orderEl.textContent === '—') {
      orderEl.textContent = rawCount > 0 ? rawCount.toLocaleString('en-GB') + '+ Orders Shipped' : '6,600+ Orders Shipped';
    }
  }

  naInitCart();
  setTimeout(naInitCart, 300);
  setTimeout(naInitCart, 1000);

// Mobile search → open Snap Search overlay
  (function() {
    function bindMobileSearch() {
      var mobileInput = document.querySelector('.na-search-mobile input');
      var snapEl = document.querySelector('snap-search');
      if (!mobileInput || !snapEl || mobileInput._snapBound) return;
      mobileInput._snapBound = true;
      function openSnap() {
        if (snapEl.open) { snapEl.open(); return; }
        if (snapEl.openSearch) { snapEl.openSearch(); return; }
        if (snapEl.show) { snapEl.show(); return; }
        var desktopInput = document.querySelector('.na-search-wrap input');
        if (desktopInput) {
          desktopInput.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
          desktopInput.dispatchEvent(new FocusEvent('focus', { bubbles: true }));
        }
      }
      mobileInput.addEventListener('focus', openSnap);
      mobileInput.addEventListener('click', openSnap);
      mobileInput.addEventListener('touchstart', openSnap);
    }
    setTimeout(bindMobileSearch, 500);
    setTimeout(bindMobileSearch, 1500);
  })();

  function naToggleDrawer() {
    var drawer = document.getElementById('naDrawer');
    var overlay = document.getElementById('naOverlay');
    var burger = document.getElementById('naBurger');
    var isOpen = drawer.classList.contains('open');
    drawer.classList.toggle('open', !isOpen);
    overlay.classList.toggle('open', !isOpen);
    burger.classList.toggle('open', !isOpen);
    burger.setAttribute('aria-expanded', String(!isOpen));
    drawer.setAttribute('aria-hidden', String(isOpen));
    document.body.style.overflow = isOpen ? '' : 'hidden';
  }

  function naDrawerTab(btn, panelId) {
    document.querySelectorAll('.na-drawer-tab').forEach(function(t) { t.classList.remove('active'); });
    document.querySelectorAll('.na-drawer-panel').forEach(function(p) { p.classList.remove('active'); });
    btn.classList.add('active');
    document.getElementById(panelId).classList.add('active');
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      var drawer = document.getElementById('naDrawer');
      if (drawer.classList.contains('open')) naToggleDrawer();
    }
  });
</script>

