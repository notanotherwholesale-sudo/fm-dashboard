{% comment %}
  NAW LIVE REVIEWS — custom carousel fed by Klaviyo/Okendo via shop.metafields.custom.reviews_feed.
  Each review: {"t":title,"q":quote,"n":Name,"s":5,"ts":minutes,"d":date}.
  Trustpilot-style cards: NA-logo avatar (cycles brand colours), name, relative date,
  green-square stars, text. Continuous scroll (pauses on hover, drag to browse).
  Speed is editor-configurable. Renders nothing if the feed is empty (fail-closed).
{% endcomment %}

{%- assign naw_feed = shop.metafields.custom.reviews_feed.value -%}
{%- if naw_feed and naw_feed.size > 0 -%}
{%- assign naw_logo = 'https://cdn.shopify.com/s/files/1/0810/4090/0375/files/Short_Logo_2_dd85eee9-6ddf-43ca-909f-a400d88426ed.jpg?v=1773141782&width=120' -%}
{%- assign naw_cols = 'white,red,gold,ink,cream' | split: ',' -%}
{%- assign naw_now = 'now' | date: '%s' | times: 1 -%}
{%- assign naw_max = section.settings.max_reviews | default: 20 -%}

<div class="naw-lrev" data-naw-lrev data-speed="{{ section.settings.speed | default: 45 }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="naw-lrev__h">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    <div class="naw-lrev__sub"><span class="naw-lrev__ssq"></span>{{ section.settings.subheading | escape }}</div>
  {%- endif -%}

  <div class="naw-lrev__viewport" data-naw-lrev-viewport>
    <div class="naw-lrev__track" data-naw-lrev-track>
      {%- assign naw_i = 0 -%}
      {%- for r in naw_feed limit: naw_max -%}
        {%- assign naw_s = r.s | default: 5 -%}
        {%- if naw_s >= 4 and r.q != blank -%}
          {%- assign cidx = naw_i | modulo: 5 -%}
          {%- assign col = naw_cols[cidx] -%}
          {%- comment -%} relative date {%- endcomment -%}
          {%- assign naw_dt = '' -%}
          {%- if r.ts -%}
            {%- assign rev_s = r.ts | times: 60 -%}
            {%- assign diff = naw_now | minus: rev_s -%}
            {%- assign days = diff | divided_by: 86400 -%}
            {%- if days < 1 -%}{%- assign naw_dt = 'Today' -%}
            {%- elsif days == 1 -%}{%- assign naw_dt = '1 day ago' -%}
            {%- elsif days < 7 -%}{%- assign naw_dt = days | append: ' days ago' -%}
            {%- elsif days < 14 -%}{%- assign naw_dt = '1 week ago' -%}
            {%- elsif days < 31 -%}{%- assign weeks = days | divided_by: 7 -%}{%- assign naw_dt = weeks | append: ' weeks ago' -%}
            {%- elsif days < 62 -%}{%- assign naw_dt = '1 month ago' -%}
            {%- else -%}{%- assign months = days | divided_by: 30 -%}{%- assign naw_dt = months | append: ' months ago' -%}
            {%- endif -%}
          {%- elsif r.d and r.d != '' -%}{%- assign naw_dt = r.d -%}{%- endif -%}
          <figure class="naw-lrev__card">
            <div class="naw-lrev__top">
              <span class="naw-lrev__av naw-lrev__av--{{ col }}"><img src="{{ naw_logo }}" alt="Not Another" loading="lazy"></span>
              <span class="naw-lrev__idw"><b class="naw-lrev__nm">{{ r.n | escape }}</b>{%- if naw_dt != '' -%}<span class="naw-lrev__dt">{{ naw_dt }}</span>{%- endif -%}</span>
            </div>
            <div class="naw-lrev__stars" aria-label="{{ naw_s }} out of 5 stars">
              {%- for i in (1..5) -%}{%- if i <= naw_s -%}<i class="sq"></i>{%- else -%}<i class="sq sq--off"></i>{%- endif -%}{%- endfor -%}
            </div>
            <blockquote class="naw-lrev__q">{{ r.q | escape }}</blockquote>
          </figure>
          {%- assign naw_i = naw_i | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="naw-lrev__cta">
    <a class="naw-lrev__btn" href="{{ section.settings.button_link | default: '/pages/reviews' }}">{{ section.settings.button_text | default: 'SEE ALL REVIEWS' }}</a>
  </div>
</div>

<style>
.naw-lrev{max-width:1320px;margin:40px auto;padding:0 20px;font-family:'Poppins',sans-serif}
.naw-lrev__h{text-align:center;font-size:clamp(24px,3vw,34px);font-weight:800;letter-spacing:-.02em;text-transform:uppercase;line-height:1.05;color:#111;margin:0 0 12px}
.naw-lrev__sub{text-align:center;display:flex;align-items:center;justify-content:center;gap:8px;font-size:13px;font-weight:600;color:#6B6B6B;margin:0 0 24px}
.naw-lrev__ssq{width:18px;height:18px;background:#15733F;border-radius:4px;display:inline-flex;align-items:center;justify-content:center}
.naw-lrev__ssq::before{content:"★";color:#fff;font-size:11px;line-height:1}
.naw-lrev__viewport{overflow:hidden;cursor:grab;-webkit-mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent);mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent)}
.naw-lrev__viewport.is-drag{cursor:grabbing}
.naw-lrev__track{display:flex;gap:22px;width:max-content;padding:16px 2px}
.naw-lrev__card{flex:0 0 356px;background:#fff;border-radius:16px;box-shadow:0 8px 28px rgba(0,0,0,.07);padding:24px 26px 26px;margin:0;display:flex;flex-direction:column}
.naw-lrev__top{display:flex;align-items:center;gap:13px;margin-bottom:15px}
.naw-lrev__av{width:46px;height:46px;border-radius:50%;flex:0 0 auto;display:flex;align-items:center;justify-content:center;overflow:hidden}
.naw-lrev__av img{width:64%;height:64%;object-fit:contain;mix-blend-mode:multiply}
.naw-lrev__av--white{background:#fff;border:1px solid #E8E8E8}
.naw-lrev__av--cream{background:#FDFBF7;border:1px solid #EFECE4}
.naw-lrev__av--red{background:#ED2C24}
.naw-lrev__av--gold{background:#F2B200}
.naw-lrev__av--ink{background:#111}
.naw-lrev__av--ink img{mix-blend-mode:normal;filter:invert(1)}
.naw-lrev__idw{display:flex;flex-direction:column}
.naw-lrev__nm{font-weight:600;font-size:15px;line-height:1.2;color:#111}
.naw-lrev__dt{font-size:12px;color:#9A9A9A;margin-top:3px}
.naw-lrev__stars{display:flex;gap:3px;margin-bottom:14px}
.naw-lrev__stars .sq{width:22px;height:22px;background:#15733F;border-radius:4px;display:flex;align-items:center;justify-content:center}
.naw-lrev__stars .sq::before{content:"★";color:#fff;font-size:13px;line-height:1}
.naw-lrev__stars .sq--off{background:#E3E3E3}
.naw-lrev__q{font-size:14.5px;line-height:1.62;color:#1f1f1f;margin:0;display:-webkit-box;-webkit-line-clamp:5;-webkit-box-orient:vertical;overflow:hidden}
.naw-lrev__cta{text-align:center;margin-top:24px}
.naw-lrev__btn{display:inline-block;background:#111;color:#fff;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;border-radius:8px;padding:15px 32px;transition:opacity .15s,transform .15s}
.naw-lrev__btn:hover{opacity:.85}
.naw-lrev__btn:active{transform:scale(.97)}
@media(max-width:640px){
  .naw-lrev{margin:26px auto;padding:0 14px}
  .naw-lrev__track{gap:12px;padding:10px 2px}
  .naw-lrev__card{flex-basis:230px;padding:15px 16px 16px;border-radius:13px}
  .naw-lrev__top{gap:10px;margin-bottom:11px}
  .naw-lrev__av{width:34px;height:34px}
  .naw-lrev__nm{font-size:12.5px}
  .naw-lrev__dt{font-size:10.5px;margin-top:2px}
  .naw-lrev__stars{gap:2px;margin-bottom:10px}
  .naw-lrev__stars .sq{width:16px;height:16px;border-radius:3px}
  .naw-lrev__stars .sq::before{font-size:9px}
  .naw-lrev__q{font-size:12px;line-height:1.55;-webkit-line-clamp:4}
  .naw-lrev__cta{margin-top:18px}
  .naw-lrev__btn{padding:12px 24px;font-size:11px}
}
</style>

<script>
(function(){
  var root=document.querySelector('[data-naw-lrev]');if(!root||root.dataset.init)return;root.dataset.init='1';
  var vp=root.querySelector('[data-naw-lrev-viewport]');
  var track=root.querySelector('[data-naw-lrev-track]');
  track.innerHTML+=track.innerHTML;
  var pos=0,speed=(parseInt(root.dataset.speed,10)||45)/1000,paused=false,dragging=false,last=null;
  var reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
  function loopWidth(){return track.scrollWidth/2;}
  function tick(ts){
    if(last===null)last=ts;
    var dt=ts-last;last=ts;
    if(!paused&&!dragging&&!reduced){
      pos+=speed*dt;
      if(pos>=loopWidth())pos-=loopWidth();
      track.style.transform='translateX('+(-pos)+'px)';
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
  vp.addEventListener('mouseenter',function(){paused=true;});
  vp.addEventListener('mouseleave',function(){paused=false;});
  var sx=0,sp=0;
  function down(x){dragging=true;sx=x;sp=pos;vp.classList.add('is-drag');}
  function move(x){if(!dragging)return;pos=sp+(sx-x);var w=loopWidth();while(pos<0)pos+=w;while(pos>=w)pos-=w;track.style.transform='translateX('+(-pos)+'px)';}
  function up(){dragging=false;vp.classList.remove('is-drag');}
  vp.addEventListener('mousedown',function(e){down(e.pageX);e.preventDefault();});
  window.addEventListener('mousemove',function(e){move(e.pageX);});
  window.addEventListener('mouseup',up);
  vp.addEventListener('touchstart',function(e){paused=true;down(e.touches[0].pageX);},{passive:true});
  vp.addEventListener('touchmove',function(e){move(e.touches[0].pageX);},{passive:true});
  vp.addEventListener('touchend',function(){up();paused=false;});
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "NAW Live reviews",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Don't just take our word for it"},
    {"type":"text","id":"subheading","label":"Rating line — leave blank to auto-calculate live from reviews"},
    {"type":"text","id":"button_text","label":"Button text","default":"SEE ALL REVIEWS"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"range","id":"max_reviews","label":"Max reviews shown","min":4,"max":30,"step":1,"default":20},
    {"type":"range","id":"speed","label":"Scroll speed (higher = faster)","min":10,"max":140,"step":5,"default":45}
  ],
  "presets": [{"name":"NAW Live reviews"}]
}
{% endschema %}
