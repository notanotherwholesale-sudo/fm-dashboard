{%- if section.settings.enabled -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap">
<style>
.nabf-root{position:fixed;inset:0;z-index:2147483000;display:none;align-items:center;justify-content:center;padding:24px;font-family:'Poppins',sans-serif}
.nabf-root.is-open{display:flex}
.nabf-root::before{content:"";position:absolute;inset:0;background:rgba(0,0,0,.74);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);animation:nabf-fade .28s ease forwards}
@keyframes nabf-fade{from{opacity:0}to{opacity:1}}
.nabf{position:relative;z-index:1;background:#0f0f0f;color:#fff;width:100%;max-width:430px;border:1px solid #1e1e1e;border-radius:18px;padding:38px 34px 28px;text-align:center;overflow:hidden;box-shadow:0 40px 110px rgba(0,0,0,.7);animation:nabf-pop .42s cubic-bezier(.16,1,.3,1)}
@keyframes nabf-pop{from{opacity:0;transform:translateY(16px) scale(.98)}to{opacity:1;transform:none}}
.nabf::before{content:"";position:absolute;inset:0;background:radial-gradient(70% 120% at 50% -10%, rgba(255,106,0,.16), rgba(255,106,0,0) 62%);pointer-events:none}
.nabf__x{position:absolute;top:12px;right:14px;width:30px;height:30px;display:grid;place-items:center;background:#1a1a1a;border:1px solid #2a2a2a;border-radius:50%;color:#8a877e;font-size:16px;line-height:1;cursor:pointer}
.nabf__x:hover{color:#fff}
.nabf__logo{display:block;height:22px;width:auto;max-width:180px;margin:0 auto 22px;filter:brightness(0) invert(1);opacity:.95;position:relative}
.nabf__eye{position:relative;display:inline-block;font-size:10px;font-weight:800;letter-spacing:.22em;text-transform:uppercase;color:#FF6A00;margin:0 0 12px}
.nabf__h{position:relative;font-weight:800;font-size:clamp(22px,5.4vw,27px);line-height:1.08;letter-spacing:-.02em;margin:0 0 6px;color:#fff;text-transform:uppercase}
.nabf__h b{color:#FF6A00;font-weight:800}
.nabf__when{position:relative;font-size:12px;color:#9c988f;margin:0 0 22px;letter-spacing:.02em}
.nabf__cd{position:relative;display:flex;justify-content:center;gap:9px;margin:0 0 24px}
.nabf__cd-box{background:#191919;border:1px solid #272727;border-radius:11px;width:70px;padding:13px 0 9px}
.nabf__cd-num{font-size:30px;font-weight:800;line-height:1;color:#fff;font-variant-numeric:tabular-nums;letter-spacing:-.02em}
.nabf__cd-lab{display:block;margin-top:7px;font-size:8.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#7c776c}
.nabf__sub{position:relative;font-size:12.5px;color:#a5a19a;margin:0 auto 18px;max-width:30ch;line-height:1.5}
.nabf__form{position:relative;display:flex;flex-direction:column;gap:10px;max-width:330px;margin:0 auto}
.nabf__input{width:100%;background:#1a1a1a;border:1px solid #2e2e2e;border-radius:9px;color:#fff;font-family:inherit;font-size:14px;padding:13px 14px;text-align:center}
.nabf__input::placeholder{color:#6b6b6b}
.nabf__input:focus{outline:none;border-color:#FF6A00}
.nabf__input.err{border-color:#e35}
.nabf__btn{width:100%;background:#FF6A00;color:#0a0a0a;border:0;border-radius:9px;font-family:inherit;font-weight:800;font-size:13.5px;letter-spacing:.07em;text-transform:uppercase;padding:14px;cursor:pointer;transition:opacity .15s,transform .12s}
.nabf__btn:hover{opacity:.9}.nabf__btn:active{transform:scale(.98)}
.nabf__done{position:relative;display:none;flex-direction:column;align-items:center;gap:8px;max-width:330px;margin:0 auto;padding:6px 0 2px}
.nabf__done.show{display:flex}
.nabf__tick{width:42px;height:42px;border-radius:50%;background:rgba(255,106,0,.14);border:1px solid rgba(255,106,0,.5);display:grid;place-items:center;color:#FF6A00;font-size:20px;line-height:1}
.nabf__done-t{font-size:14px;font-weight:700;color:#fff}
.nabf__done-s{font-size:12px;color:#a5a19a;line-height:1.5}
.nabf__legal{position:relative;font-size:10px;color:#6b6b6b;margin:14px auto 0;max-width:32ch;line-height:1.5}
@media(max-width:600px){.nabf{max-width:355px;padding:32px 22px 24px}.nabf__cd-box{width:62px}.nabf__cd-num{font-size:26px}}
@media(prefers-reduced-motion:reduce){.nabf,.nabf-root::before{animation:none}}
</style>
<div class="nabf-root" id="nabfRoot" aria-hidden="true">
  <div class="nabf" role="dialog" aria-modal="true" aria-labelledby="nabfH">
    <button class="nabf__x" id="nabfX" aria-label="Close">&times;</button>
    <img class="nabf__logo" src="https://cdn.shopify.com/s/files/1/0810/4090/0375/files/logo_transparent_black.png?v=1773070899" alt="Not Another Wholesale" width="155" height="22" loading="eager">
    <span class="nabf__eye">{{ section.settings.eyebrow | escape }}</span>
    <h2 class="nabf__h" id="nabfH">{{ section.settings.headline }}</h2>
    <p class="nabf__when">{{ section.settings.when | escape }}</p>
    <div class="nabf__cd" id="nabfCd">
      <div class="nabf__cd-box"><span class="nabf__cd-num" id="nabfD">00</span><span class="nabf__cd-lab">Days</span></div>
      <div class="nabf__cd-box"><span class="nabf__cd-num" id="nabfH2">00</span><span class="nabf__cd-lab">Hours</span></div>
      <div class="nabf__cd-box"><span class="nabf__cd-num" id="nabfM">00</span><span class="nabf__cd-lab">Mins</span></div>
      <div class="nabf__cd-box"><span class="nabf__cd-num" id="nabfS">00</span><span class="nabf__cd-lab">Secs</span></div>
    </div>
    <div id="nabfBody">
      <p class="nabf__sub">{{ section.settings.subcopy | escape }}</p>
      <form class="nabf__form" id="nabfForm" novalidate>
        <input class="nabf__input" id="nabfEmail" type="email" inputmode="email" autocomplete="email" placeholder="{{ section.settings.placeholder | escape }}" aria-label="Email address">
        <button class="nabf__btn" type="submit">{{ section.settings.cta | escape }}</button>
      </form>
    </div>
    <div class="nabf__done" id="nabfDone">
      <div class="nabf__tick">&#10003;</div>
      <div class="nabf__done-t">{{ section.settings.success_title | escape }}</div>
      <div class="nabf__done-s">{{ section.settings.success_sub | escape }}</div>
    </div>
    <p class="nabf__legal">{{ section.settings.legal | escape }}</p>
  </div>
</div>
<script>
(function(){
  var CFG={
    company:{{ section.settings.klaviyo_public_key | json }},
    list:{{ section.settings.klaviyo_list_id | json }},
    target:{{ section.settings.countdown_target | json }},
    delay:{{ section.settings.delay | default: 20 }}*1000,
    cool:{{ section.settings.cooldown_days | default: 1 }},
    hideLogged:{% if section.settings.hide_for_customers %}true{% else %}false{% endif %},
    loggedIn:{% if customer %}true{% else %}false{% endif %},
    editor:{% if request.design_mode %}true{% else %}false{% endif %}
  };
  var KEY_DONE='nabf_done',KEY_SEEN='nabf_seen';
  var root=document.getElementById('nabfRoot'); if(!root)return;
  var form=document.getElementById('nabfForm'), email=document.getElementById('nabfEmail');
  var tgt=new Date(CFG.target).getTime();
  function rd(k){try{return localStorage.getItem(k)}catch(e){return null}}
  function stw(k,v){try{localStorage.setItem(k,v)}catch(e){}}
  function pad(n){return (n<10?'0':'')+n;}
  function tick(){
    var diff=Math.max(0, tgt-Date.now());
    var s=Math.floor(diff/1000);
    document.getElementById('nabfD').textContent=pad(Math.floor(s/86400));
    document.getElementById('nabfH2').textContent=pad(Math.floor(s%86400/3600));
    document.getElementById('nabfM').textContent=pad(Math.floor(s%3600/60));
    document.getElementById('nabfS').textContent=pad(s%60);
  }
  function suppressed(){
    if(CFG.editor)return false;
    if(!isNaN(tgt)&&Date.now()>=tgt)return true;           /* sale is live — stop showing */
    if(rd(KEY_DONE))return true;
    if(CFG.hideLogged&&CFG.loggedIn)return true;
    var seen=parseInt(rd(KEY_SEEN)||'0',10);
    if(seen&&(Date.now()-seen)<CFG.cool*86400000)return true;
    if(/\/(checkouts?|orders|account)\b/.test(location.pathname))return true;
    return false;
  }
  function open(){
    if(root.classList.contains('is-open'))return;
    tick();
    root.classList.add('is-open'); root.setAttribute('aria-hidden','false');
    if(!CFG.editor)stw(KEY_SEEN,String(Date.now()));
    setTimeout(function(){try{email.focus({preventScroll:true})}catch(e){}},260);
  }
  function close(){ root.classList.remove('is-open'); root.setAttribute('aria-hidden','true'); }
  function subscribe(addr){
    if(!CFG.company||!CFG.list)return;
    try{ fetch('https://a.klaviyo.com/client/subscriptions/?company_id='+encodeURIComponent(CFG.company),{method:'POST',headers:{'Content-Type':'application/json','revision':'2024-10-15'},body:JSON.stringify({data:{type:'subscription',attributes:{custom_source:'Black Friday countdown popup',profile:{data:{type:'profile',attributes:{email:addr}}}},relationships:{list:{data:{type:'list',id:CFG.list}}}}})}); }catch(e){}
    try{ if(window.klaviyo&&typeof klaviyo.identify==='function')klaviyo.identify({'$email':addr}); }catch(e){}
  }
  document.getElementById('nabfX').addEventListener('click',function(){ if(!CFG.editor)stw(KEY_DONE,'1'); close(); });
  root.addEventListener('click',function(e){ if(e.target===root)close(); });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape'&&root.classList.contains('is-open'))close(); });
  form.addEventListener('submit',function(e){
    e.preventDefault();
    var addr=(email.value||'').trim();
    var ok=/^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(addr);
    if(!ok){ email.classList.add('err'); email.focus(); return; }
    subscribe(addr);
    if(!CFG.editor)stw(KEY_DONE,'1');
    document.getElementById('nabfBody').style.display='none';
    document.getElementById('nabfDone').classList.add('show');
    setTimeout(close, 3200);
  });
  email.addEventListener('input',function(){ email.classList.remove('err'); });
  tick(); setInterval(tick,1000);
  if(CFG.editor)open();
  else if(!suppressed())setTimeout(open,CFG.delay);
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "NA Black Friday Popup",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable popup", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Blackout · Black Friday" },
    { "type": "html", "id": "headline", "label": "Headline (b = orange)", "default": "<b>Up to 55% off</b> everything" },
    { "type": "text", "id": "when", "label": "Timing line", "default": "Doors open Friday · 10am" },
    { "type": "text", "id": "countdown_target", "label": "Countdown to (ISO)", "default": "2026-11-20T10:00:00", "info": "Timer counts to this; popup auto-hides once passed." },
    { "type": "textarea", "id": "subcopy", "label": "Subcopy", "default": "Drop your email and we’ll notify you the moment the sale goes live." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "you@email.com" },
    { "type": "text", "id": "cta", "label": "Button", "default": "Sign up to be notified" },
    { "type": "text", "id": "success_title", "label": "Success title", "default": "You’re on the list" },
    { "type": "text", "id": "success_sub", "label": "Success subtext", "default": "We’ll email you Friday at 10am when the sale goes live." },
    { "type": "textarea", "id": "legal", "label": "Small print", "default": "No spam — just your heads-up for Friday. Unsubscribe anytime." },
    { "type": "header", "content": "Klaviyo" },
    { "type": "text", "id": "klaviyo_public_key", "label": "Public API key", "default": "SHDKyV" },
    { "type": "text", "id": "klaviyo_list_id", "label": "List ID", "default": "SbB9iq", "info": "SbB9iq = Black Friday Launch → triggers the ‘You’re In’ email." },
    { "type": "header", "content": "Behaviour" },
    { "type": "range", "id": "delay", "label": "Show after", "unit": "s", "min": 0, "max": 60, "step": 1, "default": 20 },
    { "type": "range", "id": "cooldown_days", "label": "Don't show again for", "unit": "d", "min": 1, "max": 30, "step": 1, "default": 1 },
    { "type": "checkbox", "id": "hide_for_customers", "label": "Hide from logged-in customers", "default": false }
  ]
}
{% endschema %}
