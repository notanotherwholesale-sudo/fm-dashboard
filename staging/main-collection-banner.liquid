{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

<style>
  .nawcol { background: #FFFFFF; border-bottom: 1px solid #EEEEEE; }
  .nawcol__inner { max-width: {{ settings.page_width | default: 1200 }}px; margin: 0 auto; padding: 44px 24px 40px; text-align: center; }
  .nawcol__crumb { margin: 0 0 20px; font-size: 12px; letter-spacing: 0.04em; color: #6B6B6B; }
  .nawcol__crumb a { color: #6B6B6B; text-decoration: none; }
  .nawcol__crumb a:hover { color: #111; }
  .nawcol__crumb .sep { margin: 0 8px; color: #CBC7BE; }
  .nawcol__title { font-weight: 800; font-size: clamp(32px, 4.6vw, 50px); line-height: 1.04; letter-spacing: -0.02em; color: #111; margin: 0; text-transform: uppercase; }
  .nawcol__box { max-width: 820px; margin: 24px auto 0; background: #F4F4F4; border: 1px solid #111111; border-radius: 10px; padding: 24px 34px; }
  .nawcol__desc { max-width: 660px; margin: 0 auto; font-size: 16px; line-height: 1.75; color: #444; }
  .nawcol__desc p { margin: 0 0 10px; }
  .nawcol__desc p:last-child { margin-bottom: 0; }
  .nawcol__desc strong, .nawcol__desc b { color: #111; font-weight: 600; }
  .nawcol__img { max-width: 820px; margin: 24px auto 0; border-radius: 10px; overflow: hidden; display: block; }
  .nawcol__img img { display: block; width: 100%; height: auto; }
  @media (max-width: 600px) {
    .nawcol__inner { padding: 26px 16px 26px; }
    .nawcol__box { padding: 20px 20px; border-radius: 8px; }
    .nawcol__desc { font-size: 15px; }
  }
</style>

<div class="nawcol color-{{ section.settings.color_scheme }}">
  <div class="nawcol__inner{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">

    <nav class="nawcol__crumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span class="sep">&rsaquo;</span><a href="{{ routes.collections_url }}">Collections</a><span class="sep">&rsaquo;</span>{{ collection.title | escape }}
    </nav>

    <h1 class="nawcol__title">
      <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
      {{- collection.title | escape -}}
    </h1>

    {%- if collection.description != blank -%}
      <div class="nawcol__box">
        <div class="nawcol__desc rte">{{ collection.description }}</div>
      </div>
    {%- endif -%}

    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="nawcol__img media">
        <img
          srcset="
            {%- if collection.image.width >= 375 -%}{{ collection.image | image_url: width: 375 }} 375w,{%- endif -%}
            {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if collection.image.width >= 1100 -%}{{ collection.image | image_url: width: 1100 }} 1100w,{%- endif -%}
            {{ collection.image | image_url }} {{ collection.image.width }}w
          "
          src="{{ collection.image | image_url: width: 1100 }}"
          sizes="(min-width: 820px) 820px, calc(100vw - 32px)"
          alt="{{ collection.image.alt | escape }}"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
          loading="lazy"
        >
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label",
      "info": "t:sections.main-collection-banner.settings.show_collection_image.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    }
  ]
}
{% endschema %}
