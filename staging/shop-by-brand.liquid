{% comment %}
  Shop By Brand grid — used in the burger drawer "Brands" tab (see sections/header.liquid).
  2-up on mobile / 3-up on wider drawers. Tiles mirror the homepage "Shop Our Brands" strip.

  IMAGE PER TILE: shows the collection's featured image if one is set
  (Shopify admin > Products > Collections > [brand] > add an Image),
  otherwise falls back to that brand's first product photo so it's never empty.
  To match the homepage cutouts exactly, set each brand collection's image in admin.

  Order is by prominence / best-sellers. Edit the brand_pairs list to add/remove/reorder.
  Format: "collection-handle|Display Name".
{% endcomment %}
{%- liquid
  assign brand_pairs = 'carhartt|Carhartt,ralph-lauren|Ralph Lauren,levis|Levis,the-north-face-1|The North Face,tommy-hilfiger|Tommy Hilfiger,nike|Nike,dickies|Dickies,patagonia|Patagonia,lacoste|Lacoste,adidas|Adidas,wrangler|Wrangler,columbia|Columbia,champion|Champion,nautica|Nautica,lee|Lee,eddie-bauer|Eddie Bauer,realtree|Realtree,harley-davidson|Harley Davidson' | split: ','
-%}
<div class="sbb">
  <div class="sbb__head">
    <span class="sbb__title">Shop By Brand</span>
    <span class="sbb__sub">Every big label we stock — tap a brand to see its bundles.</span>
  </div>
  <div class="sbb__grid">
    {%- for pair in brand_pairs -%}
      {%- assign parts = pair | split: '|' -%}
      {%- assign h = parts[0] -%}
      {%- assign label = parts[1] -%}
      {%- assign coll = collections[h] -%}
      {%- if coll != blank and coll.products_count > 0 -%}
        {%- assign img = coll.image | default: coll.products.first.featured_image -%}
        <a href="{{ coll.url }}" class="sbb__tile" aria-label="{{ label | escape }}">
          <span class="sbb__imgwrap">
            {%- if img != blank -%}
              {{ img | image_url: width: 300 | image_tag: loading: 'lazy', widths: '120,180,240,300', sizes: '(min-width: 750px) 20vw, 40vw', class: 'sbb__img', alt: label }}
            {%- else -%}
              <span class="sbb__placeholder" aria-hidden="true">{{ label | slice: 0 }}</span>
            {%- endif -%}
          </span>
          <span class="sbb__name">{{ label }}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <a href="/collections/all" class="sbb__all">View all bundles &#8250;</a>
</div>
<style>
  .sbb {
    padding: 18px 20px 10px;
  }
  .sbb__head {
    margin: 0 0 16px;
  }
  .sbb__title {
    display: block;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #111;
    padding-bottom: 8px;
    border-bottom: 2px solid #111;
  }
  .sbb__sub {
    display: block;
    margin-top: 8px;
    font-family: 'Poppins', sans-serif;
    font-size: 11.5px;
    line-height: 1.45;
    color: #888;
  }
  .sbb__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 12px;
  }
  @media screen and (min-width: 750px) {
    .sbb__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px 14px;
    }
  }
  .sbb__tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: #111;
    transition: transform 0.18s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .sbb__tile:active {
    transform: scale(0.97);
  }
  .sbb__imgwrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #ffffff;
    border: 1px solid #f0f0ee;
    border-radius: 10px;
    overflow: hidden;
  }
  .sbb__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 6px;
  }
  .sbb__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: #f4f4f2;
    border-radius: 10px;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 24px;
    color: #b8b8b8;
  }
  .sbb__name {
    margin-top: 9px;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: #111;
  }
  .sbb__all {
    display: block;
    margin-top: 18px;
    padding: 12px 0;
    text-align: center;
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #111;
    text-decoration: none;
    border-top: 1px solid #efefed;
  }
  .sbb__all:hover {
    color: #000;
  }
</style>
