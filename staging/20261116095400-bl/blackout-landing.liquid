{%- liquid
  assign end_iso = section.settings.end_date | default: '2026-12-01T23:59:59'
  assign disc = section.settings.discount_pct | default: 30
  assign mult = 100 | minus: disc | times: 1.0 | divided_by: 100.0
  assign coll = section.settings.deals_collection
-%}
<div class="bl">
  <section class="bl-hero">
    <div class="bl-hero__in">
      <div class="bl-hero__copy">
        {%- if section.settings.eyebrow != blank -%}<div class="bl-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h1 class="bl-h1">{{ section.settings.heading }}</h1>
        {%- if section.settings.subtext != blank -%}<p class="bl-sub">{{ section.settings.subtext }}</p>{%- endif -%}
        <div class="bl-cta">
          <a class="bl-btn" href="{{ section.settings.cta_link | default: '/collections/all-bundles' }}">{{ section.settings.cta_label | default: 'Shop the sale' }}</a>
          {%- if section.settings.cta2_link != blank -%}<a class="bl-link" href="{{ section.settings.cta2_link }}">{{ section.settings.cta2_label | default: 'See the 50% Wall' }}</a>{%- endif -%}
        </div>
        <div class="bl-cd" data-bl-end="{{ end_iso }}">
          <span class="bl-cd__lab">Ends Tue 1 Dec</span>
          <span class="bl-cd__u"><b data-d>00</b><span>d</span></span><span class="bl-cd__s">·</span>
          <span class="bl-cd__u"><b data-h>00</b><span>h</span></span><span class="bl-cd__s">·</span>
          <span class="bl-cd__u"><b data-m>00</b><span>m</span></span><span class="bl-cd__s">·</span>
          <span class="bl-cd__u"><b data-s>00</b><span>s</span></span>
        </div>
      </div>
      {%- assign feat = section.settings.featured_product -%}
      {%- if feat == blank and coll != blank -%}{%- assign feat = coll.products.first -%}{%- endif -%}
      {%- if feat != blank -%}
        {%- assign fv = feat.selected_or_first_available_variant -%}
        {%- assign f_black = feat.price | times: mult | round -%}
        {%- assign f_list = fv.compare_at_price | default: feat.price -%}
        {%- assign f_off = f_list | minus: f_black | times: 100 | divided_by: f_list -%}
        <a class="bl-feat" href="{{ feat.url }}">
          <div class="bl-feat__media">
            {%- if feat.featured_image -%}<img src="{{ feat.featured_image | image_url: width: 640 }}" alt="{{ feat.featured_image.alt | escape }}" loading="lazy" width="640" height="480">{%- else -%}<span class="bl-ph">Featured deal</span>{%- endif -%}
            <span class="bl-tag">&minus;{{ f_off }}%</span>
          </div>
          <div class="bl-feat__b">
            <div class="bl-feat__t">{{ feat.title }}</div>
            <div class="bl-feat__p"><span class="now">{{ f_black | money }}</span><span class="was">{{ f_list | money }}</span></div>
            <div class="bl-feat__note">Extra {{ disc }}% already applied &middot; at checkout</div>
            <span class="bl-feat__btn">Shop now</span>
          </div>
        </a>
      {%- endif -%}
    </div>
  </section>

  <div class="bl-trust">
    <div class="bl-trust__in">
      <span><b>35,000+</b> pieces in stock</span>
      <span>Order by <b>11am</b>, ships today</span>
      <span>Hand-graded <b>A/B</b></span>
      <span><b>2+ bundles</b> ship free UK</span>
      <span><b>7,000+</b> orders shipped</span>
    </div>
  </div>

  {%- if coll != blank and coll.products.size > 0 -%}
  <section class="bl-block">
    <div class="bl-sh">
      <div><h2>{{ section.settings.deals_heading | default: 'Best sellers, going fast' }}</h2>
      <p>Blackout price shown &mdash; the extra {{ disc }}% is applied at checkout.</p></div>
      <a href="{{ coll.url }}">View all {{ coll.products_count }}</a>
    </div>
    <div class="bl-grid">
      {%- assign lim = section.settings.deals_limit | default: 6 -%}
      {%- for p in coll.products limit: lim -%}
        {%- assign pv = p.selected_or_first_available_variant -%}
        {%- assign excluded = false -%}
        {%- if p.tags contains 'bf-exclude' -%}{%- assign excluded = true -%}{%- endif -%}
        {%- assign black = p.price | times: mult | round -%}
        {%- assign list_p = pv.compare_at_price | default: p.price -%}
        {%- assign off = list_p | minus: black | times: 100 | divided_by: list_p -%}
        <a class="bl-card" href="{{ p.url }}">
          <div class="bl-card__media">
            {%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 480 }}" alt="{{ p.featured_image.alt | escape }}" loading="lazy" width="480" height="480">{%- else -%}<span class="bl-ph">{{ p.title | truncatewords: 2, '' }}</span>{%- endif -%}
            {%- unless excluded -%}<span class="bl-tag">&minus;{{ off }}%</span>{%- endunless -%}
          </div>
          <div class="bl-card__b">
            <div class="bl-card__t">{{ p.title }}</div>
            {%- if excluded -%}
              <div class="bl-p"><span class="now">{{ p.price | money }}</span></div>
            {%- else -%}
              <div class="bl-p"><span class="now">{{ black | money }}</span><span class="was">{{ list_p | money }}</span></div>
            {%- endif -%}
            {%- if pv.inventory_management != blank and pv.inventory_quantity > 0 and pv.inventory_quantity <= 10 -%}
              <div class="bl-left">Only <b>{{ pv.inventory_quantity }}</b> left</div>
            {%- else -%}
              <div class="bl-left bl-left--muted">In stock</div>
            {%- endif -%}
            <span class="bl-add">View deal</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}
</div>

<style>
.bl{font-family:'Poppins',-apple-system,sans-serif;color:#141414;--acc:#FF6A00;--accink:#D85900;--accsoft:#FBEEE2;--line:#ECE9E2;--line2:#DED9CF;--muted:#6B6B6B;--faint:#9A968E;--tile:#F4F4F3;--sh:0 1px 2px rgba(20,20,20,.04),0 8px 24px -16px rgba(20,20,20,.12)}
.bl *{box-sizing:border-box}
.bl a{text-decoration:none;color:inherit}
.bl img{max-width:100%;display:block}
.bl h1,.bl h2{margin:0;letter-spacing:-.02em;text-wrap:balance}
.bl-hero{border-bottom:1px solid var(--line)}
.bl-hero__in{max-width:1120px;margin:0 auto;padding:56px 18px;display:grid;grid-template-columns:1.1fr .9fr;gap:52px;align-items:center}
.bl-eyebrow{font-size:11.5px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}
.bl-h1{font-size:clamp(34px,5.5vw,56px);font-weight:800;line-height:1.03;margin:16px 0 0}
.bl-h1 em{font-style:normal;color:var(--acc)}
.bl-sub{color:var(--muted);font-size:15.5px;max-width:30em;margin:18px 0 0}
.bl-sub b{color:#141414;font-weight:600}
.bl-cta{display:flex;align-items:center;gap:20px;margin-top:28px;flex-wrap:wrap}
.bl-btn{display:inline-flex;align-items:center;justify-content:center;font-weight:600;font-size:14px;padding:14px 28px;border-radius:8px;background:#141414;color:#fff;transition:opacity .15s,transform .12s}
.bl-btn:hover{opacity:.88}.bl-btn:active{transform:scale(.98)}
.bl-link{font-size:14px;font-weight:600;border-bottom:1.5px solid var(--acc);padding-bottom:2px}
.bl-cd{margin-top:26px;display:flex;align-items:center;gap:12px;color:var(--muted);font-size:13px;font-weight:500;font-variant-numeric:tabular-nums}
.bl-cd__u{display:inline-flex;align-items:baseline;gap:3px}
.bl-cd__u b{font-size:19px;font-weight:800;color:#141414}
.bl-cd__u span{font-size:10px;font-weight:600;color:var(--faint);text-transform:uppercase}
.bl-cd__s{color:var(--line2)}
.bl-feat{display:block;background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:var(--sh);transition:transform .12s,border-color .15s}
.bl-feat:hover{transform:translateY(-2px);border-color:var(--line2)}
.bl-feat__media{aspect-ratio:4/3;background:var(--tile);position:relative;display:flex;align-items:center;justify-content:center;border-bottom:1px solid var(--line)}
.bl-feat__media img{width:100%;height:100%;object-fit:cover}
.bl-ph{font-size:10.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--faint)}
.bl-tag{position:absolute;top:12px;left:12px;background:var(--acc);color:#fff;font-weight:700;font-size:12px;padding:4px 9px;border-radius:6px}
.bl-feat__b{padding:18px}
.bl-feat__t{font-weight:600;font-size:15px;line-height:1.3}
.bl-feat__p{display:flex;align-items:baseline;gap:10px;margin-top:10px}
.bl-feat__p .now{font-size:23px;font-weight:800}
.bl-feat__p .was{font-size:14px;color:var(--faint);text-decoration:line-through}
.bl-feat__note{font-size:12px;color:var(--muted);margin-top:4px}
.bl-feat__btn{display:inline-block;margin-top:14px;background:#141414;color:#fff;border-radius:8px;font-weight:600;font-size:13.5px;padding:12px 18px}
.bl-trust{border-bottom:1px solid var(--line)}
.bl-trust__in{max-width:1120px;margin:0 auto;padding:14px 18px;display:flex;flex-wrap:wrap;gap:8px 28px;justify-content:center;font-size:12.5px;color:var(--muted)}
.bl-trust__in b{color:#141414;font-weight:600}
.bl-block{max-width:1120px;margin:0 auto;padding:48px 18px}
.bl-sh{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:20px}
.bl-sh h2{font-size:clamp(20px,3vw,26px);font-weight:700}
.bl-sh p{font-size:13px;color:var(--muted);margin:5px 0 0}
.bl-sh a{font-size:13px;font-weight:600;border-bottom:1.5px solid var(--acc);padding-bottom:1px;white-space:nowrap}
.bl-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.bl-card{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden;display:flex;flex-direction:column;box-shadow:var(--sh);transition:transform .12s,border-color .15s}
.bl-card:hover{transform:translateY(-2px);border-color:var(--line2)}
.bl-card__media{aspect-ratio:1/1;background:var(--tile);position:relative;display:flex;align-items:center;justify-content:center;border-bottom:1px solid var(--line)}
.bl-card__media img{width:100%;height:100%;object-fit:cover}
.bl-card__b{padding:15px;display:flex;flex-direction:column;gap:7px;flex:1}
.bl-card__t{font-weight:600;font-size:14px;line-height:1.3}
.bl-p{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap}
.bl-p .now{font-size:19px;font-weight:800}
.bl-p .was{font-size:12.5px;color:var(--faint);text-decoration:line-through}
.bl-left{font-size:11.5px;color:var(--accink);font-weight:600}
.bl-left b{font-weight:700}
.bl-left--muted{color:var(--faint);font-weight:500}
.bl-add{margin-top:auto;text-align:center;border:1px solid #141414;border-radius:8px;font-weight:600;font-size:12.5px;padding:11px;transition:background .15s,color .15s}
.bl-card:hover .bl-add{background:#141414;color:#fff}
@media(max-width:820px){.bl-hero__in{grid-template-columns:1fr;gap:32px;padding:38px 18px}.bl-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:460px){.bl-grid{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){.bl *{transition:none!important}}
</style>
<script>
(function(){
  var el=document.querySelector('.bl-cd[data-bl-end]'); if(!el||el.__bl)return; el.__bl=1;
  var end=Date.parse(el.getAttribute('data-bl-end'))||Date.parse(el.getAttribute('data-bl-end')+'Z');
  function pad(n){return (n<10?'0':'')+n;}
  function t(){
    var s=Math.max(0,Math.floor((end-Date.now())/1000));
    var d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60),ss=s%60;
    var q=function(a){return el.querySelector(a);};
    if(q('[data-d]'))q('[data-d]').textContent=pad(d);
    if(q('[data-h]'))q('[data-h]').textContent=pad(h);
    if(q('[data-m]'))q('[data-m]').textContent=pad(m);
    if(q('[data-s]'))q('[data-s]').textContent=pad(ss);
  }
  t(); setInterval(t,1000);
})();
</script>

{% schema %}
{
  "name": "Blackout Landing",
  "tag": "section",
  "class": "section-blackout",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Black Friday · 27 Nov – 1 Dec" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "An extra 30% off. Automatically." },
    { "type": "textarea", "id": "subtext", "label": "Sub text", "default": "Our Black Friday sale takes 30% off prices that are already reduced — no code, applied at checkout. Up to 53% off bales, boxes and branded reseller bundles." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the sale" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary link label", "default": "See the 50% Wall" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "text", "id": "end_date", "label": "Countdown end (ISO, GMT)", "default": "2026-12-01T23:59:59" },
    { "type": "range", "id": "discount_pct", "min": 5, "max": 60, "step": 5, "unit": "%", "label": "Discount shown", "default": 30 },
    { "type": "header", "content": "Deals grid" },
    { "type": "product", "id": "featured_product", "label": "Hero featured product (optional)" },
    { "type": "collection", "id": "deals_collection", "label": "Deals collection" },
    { "type": "text", "id": "deals_heading", "label": "Deals heading", "default": "Best sellers, going fast" },
    { "type": "range", "id": "deals_limit", "min": 3, "max": 12, "step": 3, "label": "Products", "default": 6 }
  ],
  "presets": [{ "name": "Blackout Landing" }]
}
{% endschema %}
