{%- liquid
  assign base = 'https://cdn.shopify.com/s/files/1/0810/4090/0375/files/'
  assign cat_handles = 'jackets,knitwear,hoodies,t-shirts,trousers,shorts,shirts-polo-shirts,accessories' | split: ','
  assign cat_labels = 'Jackets & Coats|Knitwear & Fleeces|Sweatshirts & Hoodies|T-Shirts|Trousers|Shorts|Shirts & Polos|Accessories' | split: '|'
  assign cat_imgs = 'UNBRANDEDDENIMJACKET.png?v=1787655557|GapKnitwear.png?v=1787319848|COLLEGEHOODIESWEATSHIRT.png?v=1751632572|SINGLESTITCHT-SHIRT.png?v=1751632586|BRANDEDCHINOPANTS.png?v=1789988384|LEVIS501CUTOFFSHORTS.png?v=1782907806|RALPHLAURENPOLOSHIRT.png?v=1751632589|BRANDEDCAPS.png?v=1751633444' | split: '|'

  assign col_handles = 'best-sellers,under-150,reseller-bundles,winter-drop,spring-summer,sportswear,workwear,premium,unbranded,bales,all-bundles,sale' | split: ','
  assign col_labels = 'Best Sellers|Under £150|Reseller Bundles|Autumn / Winter|Spring / Summer|Sportswear|Workwear|Premium|Unbranded|Bales|Bundles|Sale' | split: '|'
  assign col_imgs = 'LEVISMIXEDCODEA_B.png?v=1751632469|KIDSMIX.png?v=1751632423|VINTEDDEPOPRESELLER.png?v=1751632549|CHRISTMASJUMPERS.png?v=1791816190|UnrbrandedCargoShorts.png?v=1774968234|ADIDASTRACKPANTS.png?v=1751632470|UnbrandedCoverallDungarees.png?v=1787913392|NORTHFACEDOWNJACKET.png?v=1751632493|UNBRANDEDCORDUROYSHIRT.png?v=1751632496|Bulk1_jnkdscnksjd_11.png?v=1751632456|PREMIUMTRACKJACKET_7e3c1c2d-d2d4-4fa6-8d56-bcadd80a31f6.png?v=1760976808|TOMMYKNITWEAR.png?v=1753458229' | split: '|'
-%}

<style>
  .nacl { max-width: {{ settings.page_width | default: 1200 }}px; margin: 0 auto; padding: 4px 24px 64px; }
  .nacl__group + .nacl__group { margin-top: 54px; }
  .nacl__eyebrow { text-align: center; font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: #8A8A8A; margin: 0 0 26px; }
  .nacl__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .nacl__card { display: flex; flex-direction: column; height: 100%; text-decoration: none; background: #FFFFFF; border: 1px solid #E6E6E6; border-radius: 14px; overflow: hidden; transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease; }
  .nacl__card:hover { border-color: #111; transform: translateY(-3px); box-shadow: 0 10px 24px rgba(0,0,0,0.08); }
  .nacl__imgwrap { position: relative; width: 100%; aspect-ratio: 1 / 1; background: #F5F5F4; overflow: hidden; }
  .nacl__imgwrap img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .nacl__card:hover .nacl__imgwrap img { transform: scale(1.05); }
  .nacl__noimg { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #BBB; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
  .nacl__foot { flex: 1 0 auto; display: flex; align-items: center; justify-content: center; text-align: center; padding: 15px 12px; border-top: 1px solid #EEEEEE; }
  .nacl__name { font-weight: 600; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: #111; line-height: 1.35; text-wrap: balance; }
  @media (max-width: 989px) { .nacl__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; } }
  @media (max-width: 599px) { .nacl { padding: 4px 16px 44px; } .nacl__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; } .nacl__name { font-size: 11.5px; letter-spacing: .04em; } .nacl__foot { padding: 12px 8px; } }
</style>

<div class="page-width">
  <h1 class="title title--primary inline-richtext{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ section.settings.title }}
  </h1>
</div>

<div class="nacl">
  {%- for grp in (1..2) -%}
    {%- liquid
      if grp == 1
        assign handles = cat_handles
        assign labels = cat_labels
        assign imgs = cat_imgs
        assign eyebrow = 'Shop by Category'
      else
        assign handles = col_handles
        assign labels = col_labels
        assign imgs = col_imgs
        assign eyebrow = 'Shop by Collection'
      endif
    -%}
    <div class="nacl__group">
      <p class="nacl__eyebrow">{{ eyebrow }}</p>
      <ul class="nacl__grid" role="list">
        {%- for h in handles -%}
          {%- assign coll = collections[h] -%}
          {%- if coll != blank and coll.id -%}
            {%- assign lbl = labels[forloop.index0] -%}
            {%- if lbl == blank -%}{%- assign lbl = coll.title -%}{%- endif -%}
            {%- assign fixed = imgs[forloop.index0] -%}
            {%- assign img_url = '' -%}
            {%- if fixed != blank -%}
              {%- assign img_url = base | append: fixed -%}
            {%- else -%}
              {%- assign ti = coll.image -%}
              {%- unless ti -%}
                {%- for p in coll.products -%}{%- if p.available and p.featured_image -%}{%- assign ti = p.featured_image -%}{%- break -%}{%- endif -%}{%- endfor -%}
              {%- endunless -%}
              {%- unless ti -%}{%- assign ti = coll.featured_image -%}{%- endunless -%}
              {%- if ti -%}{%- assign img_url = ti | image_url: width: 600 -%}{%- endif -%}
            {%- endif -%}
            <li>
              <a href="{{ coll.url }}" class="nacl__card">
                <div class="nacl__imgwrap">
                  {%- if img_url != blank -%}
                    <img src="{{ img_url }}{% if fixed != blank %}&width=600{% endif %}" alt="{{ lbl | escape }}" width="600" height="600" loading="lazy">
                  {%- else -%}
                    <div class="nacl__noimg">{{ lbl | escape }}</div>
                  {%- endif -%}
                </div>
                <div class="nacl__foot"><span class="nacl__name">{{ lbl | escape }}</span></div>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "t:sections.main-list-collections.name",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:sections.main-list-collections.settings.title.label",
      "default": "Collections"
    },
    {
      "type": "select",
      "id": "sort",
      "options": [
        { "value": "alphabetical", "label": "t:sections.main-list-collections.settings.sort.options__1.label" },
        { "value": "alphabetical_reversed", "label": "t:sections.main-list-collections.settings.sort.options__2.label" },
        { "value": "date_reversed", "label": "t:sections.main-list-collections.settings.sort.options__3.label" },
        { "value": "date", "label": "t:sections.main-list-collections.settings.sort.options__4.label" },
        { "value": "products_high", "label": "t:sections.main-list-collections.settings.sort.options__5.label" },
        { "value": "products_low", "label": "t:sections.main-list-collections.settings.sort.options__6.label" }
      ],
      "default": "alphabetical",
      "label": "t:sections.main-list-collections.settings.sort.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "t:sections.main-list-collections.settings.image_ratio.options__1.label" },
        { "value": "portrait", "label": "t:sections.main-list-collections.settings.image_ratio.options__2.label" },
        { "value": "square", "label": "t:sections.main-list-collections.settings.image_ratio.options__3.label" }
      ],
      "default": "adapt",
      "label": "t:sections.main-list-collections.settings.image_ratio.label",
      "info": "t:sections.main-list-collections.settings.image_ratio.info"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "t:sections.main-list-collections.settings.columns_desktop.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-list-collections.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "t:sections.main-list-collections.settings.columns_mobile.options__1.label" },
        { "value": "2", "label": "t:sections.main-list-collections.settings.columns_mobile.options__2.label" }
      ],
      "default": "2",
      "label": "t:sections.main-list-collections.settings.columns_mobile.label"
    }
  ]
}
{% endschema %}
