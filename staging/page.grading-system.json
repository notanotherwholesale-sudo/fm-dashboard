    "custom_liquid_dBHKpf": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"na-grading-page\">\n\n  <div class=\"na-page-header\">\n    <h1>OUR GRADING SYSTEM</h1>\n    <p class=\"na-page-subtitle\">Transparent. Consistent. Reseller-Approved.</p>\n    <div class=\"na-divider\"></div>\n  </div>\n\n  <div class=\"na-grade-intro-wrap\">\n    <div class=\"na-grade-intro\">\n      <p>\n        <span class=\"na-grade-intro-lead\">\n          Every item we sell is manually checked and graded in-house\n        </span>\n        using the same criteria our resellers rely on.\n        <br><br>\n        Our grading system is designed to be\n        <strong>clear</strong>, <strong>consistent</strong> and\n        <strong>resale-focused</strong> &mdash; so you know exactly what to expect\n        before you buy.\n      </p>\n      <div class=\"na-scroll-cue\">Scroll down for a full breakdown of each grade &darr;</div>\n    </div>\n  </div>\n\n  <div class=\"na-grade-grid\">\n\n    <div class=\"na-grade-card\">\n      <span class=\"na-grade-pill\">A GRADE</span>\n      <p class=\"na-grade-summary\">Great overall condition. Minimal wear. Highest resale potential.</p>\n      <ul>\n        <li>Light signs of wear only</li>\n        <li>No major flaws or damage</li>\n        <li>Ideal for premium listings</li>\n      </ul>\n    </div>\n\n    <div class=\"na-grade-card\">\n      <span class=\"na-grade-pill\">B GRADE</span>\n      <p class=\"na-grade-summary\">Good wearable condition with visible but acceptable wear.</p>\n      <ul>\n        <li>Washable marks, fading &amp; wear</li>\n        <li>May need extra attention</li>\n        <li>Strong value for volume resellers</li>\n      </ul>\n    </div>\n\n    <div class=\"na-grade-card\">\n      <span class=\"na-grade-pill\">C GRADE</span>\n      <p class=\"na-grade-summary\">Heavily worn items suited to repair, rework or budget resale.</p>\n      <ul>\n        <li>Large stains and repairs needed</li>\n        <li>Will require cleaning or fixing</li>\n        <li>Best for upcyclers &amp; bulk sellers</li>\n      </ul>\n    </div>\n\n  </div>\n\n  <section class=\"na-section\" id=\"how-we-grade\">\n    <h2 class=\"na-section-title\">How We Grade</h2>\n    <p class=\"na-section-subtitle\">\n      Every piece is assessed in-house using the same consistent checks. We grade on\n      <strong>condition</strong> and <strong>resale viability</strong> &mdash; not hype, brand, or trend value.\n    </p>\n    <div class=\"na-criteria-grid\">\n      <div class=\"na-criteria-item\"><span class=\"na-criteria-label\">Stains &amp; Marks</span><p class=\"na-criteria-desc\">Visibility, size, placement, and likelihood of washing out.</p></div>\n      <div class=\"na-criteria-item\"><span class=\"na-criteria-label\">Holes &amp; Damage</span><p class=\"na-criteria-desc\">Tears, pinholes, seam splits, and overall integrity.</p></div>\n      <div class=\"na-criteria-item\"><span class=\"na-criteria-label\">Fabric Wear</span><p class=\"na-criteria-desc\">Thinning, pilling, pulls, and general fabric fatigue.</p></div>\n      <div class=\"na-criteria-item\"><span class=\"na-criteria-label\">Print / Graphics</span><p class=\"na-criteria-desc\">Cracking, fading, peel, and overall presentation.</p></div>\n      <div class=\"na-criteria-item\"><span class=\"na-criteria-label\">Shape / Fit</span><p class=\"na-criteria-desc\">Stretching, shrinkage, warping, and collar/cuff wear.</p></div>\n      <div class=\"na-criteria-item\"><span class=\"na-criteria-label\">Hardware</span><p class=\"na-criteria-desc\">Zips, buttons, snaps, and fastening function (where applicable).</p></div>\n    </div>\n  </section>\n\n  <section class=\"na-section na-accordion-wrap\" id=\"grade-breakdown\">\n    <h2 class=\"na-section-title\">Grade Breakdown</h2>\n    <p class=\"na-section-subtitle\">Tap a grade to view exactly what you can expect &mdash; including typical flaws and resale notes.</p>\n\n    <details class=\"na-accordion\">\n      <summary>\n        <div class=\"na-acc-left\">\n          <div class=\"na-acc-topline\"><span class=\"na-pill\">A Grade</span><p class=\"na-acc-title\">Premium Vintage</p></div>\n          <p class=\"na-acc-snippet\">Minimal wear. Highest resale potential. Best for premium listings.</p>\n        </div>\n        <div class=\"na-chevron\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div>\n      </summary>\n      <div class=\"na-acc-body\">\n        <div class=\"na-acc-grid\">\n          <div class=\"na-acc-box\"><h4>You may see</h4><ul><li>Light wash wear / gentle fading</li><li>Minor pilling or lint (normal vintage)</li><li>Very small, low-visibility marks</li></ul></div>\n          <div class=\"na-acc-box\"><h4>You won&rsquo;t see</h4><ul><li>Large visible stains</li><li>Holes/tears or major repairs needed</li><li>Major structural issues affecting wearability</li></ul></div>\n        </div>\n        <p class=\"na-acc-note\"><strong>Resale notes:</strong> Lowest prep time, highest sell-through. Perfect for curated drops and premium bundles.</p>\n      </div>\n    </details>\n\n    <details class=\"na-accordion\">\n      <summary>\n        <div class=\"na-acc-left\">\n          <div class=\"na-acc-topline\"><span class=\"na-pill\">B Grade</span><p class=\"na-acc-title\">Good Wearable Vintage</p></div>\n          <p class=\"na-acc-snippet\">Visible but acceptable wear. Strong value for volume resellers.</p>\n        </div>\n        <div class=\"na-chevron\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div>\n      </summary>\n      <div class=\"na-acc-body\">\n        <div class=\"na-acc-grid\">\n          <div class=\"na-acc-box\"><h4>You may see</h4><ul><li>Washable marks or small staining</li><li>Noticeable fading / general wash wear</li><li>Cracking, flaws on graphic</li><li>Split knees and broken belt loops on pants</li><li>Missing tags, stretched necklines, missing drawstrings</li></ul></div>\n          <div class=\"na-acc-box\"><h4>You won&rsquo;t see</h4><ul><li>Multiple large stains across the garment</li><li>Severe damage making the item unwearable</li><li>&ldquo;Bin stock&rdquo; level condition dumping</li></ul></div>\n        </div>\n        <p class=\"na-acc-note\"><strong>Resale notes:</strong> Best margins in bulk. Some items may need cleaning, steaming, or minor fixes before listing.</p>\n      </div>\n    </details>\n\n    <details class=\"na-accordion\">\n      <summary>\n        <div class=\"na-acc-left\">\n          <div class=\"na-acc-topline\"><span class=\"na-pill\">C Grade</span><p class=\"na-acc-title\">Project / Rework Stock</p></div>\n          <p class=\"na-acc-snippet\">Heavy wear. Best suited for repair, rework, upcycling, or budget resale.</p>\n        </div>\n        <div class=\"na-chevron\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div>\n      </summary>\n      <div class=\"na-acc-body\">\n        <div class=\"na-acc-grid\">\n          <div class=\"na-acc-box\"><h4>You may see</h4><ul><li>Large stains, heavy discolouration</li><li>Holes/tears &mdash; repairs required</li><li>Damaged linings and flaking</li><li>Heavy fading, thinning, stretched shape</li></ul></div>\n          <div class=\"na-acc-box\"><h4>Good to know</h4><ul><li>Best used for rework/upcycling or clearance sellers</li><li>Prep time is higher (cleaning/repair)</li><li>Condition is reflected in the price/value</li></ul></div>\n        </div>\n        <p class=\"na-acc-note\"><strong>Resale notes:</strong> Ideal for creatives and bulk sellers who can repair, rework, or sell as budget vintage.</p>\n      </div>\n    </details>\n  </section>\n\n  <section class=\"na-section\" id=\"condition-on-arrival\">\n    <h2 class=\"na-section-title\">Condition on Arrival</h2>\n    <p class=\"na-section-subtitle\">How your vintage stock is stored, transported, and what to expect when it arrives.</p>\n    <div class=\"na-picker\">\n      <div class=\"na-picker-grid\">\n        <div class=\"na-picker-item\"><h4>Baled for Transport</h4><p>To move large volumes safely and efficiently, items are packed and transported in compressed bales. This can cause temporary creasing or compression marks.</p></div>\n        <div class=\"na-picker-item\"><h4>Not Pre-Washed</h4><p>Most items are <strong>not washed prior to dispatch</strong>. This preserves fabric integrity and keeps stock in its original vintage condition.</p></div>\n        <div class=\"na-picker-item\"><h4>Freshen Before Listing</h4><p>Washing and/or steaming is the best way to refresh items, release bale creases, and help reduce or remove light marks picked up during storage.</p></div>\n      </div>\n      <p class=\"na-acc-note\" style=\"margin-top:1rem;\">Creases, light marks, or compression lines caused by baling are <strong>not grading faults</strong> and are considered normal for vintage wholesale.</p>\n    </div>\n  </section>\n\n  <section class=\"na-section na-faq\" id=\"grading-faq\">\n    <h2 class=\"na-section-title\">FAQs</h2>\n    <p class=\"na-section-subtitle\">Vintage is pre-loved by nature. These answers help set clear expectations before you order.</p>\n\n    <details><summary>Is A Grade flawless?</summary><div class=\"na-faq-body\">No vintage item is &ldquo;brand new&rdquo;. A Grade means <strong>no major stains, holes, or structural damage</strong> &mdash; but light wear and age-related character can still be present.</div></details>\n    <details><summary>Are marks in B Grade always washable?</summary><div class=\"na-faq-body\">Many marks are washable, but not all. B Grade is priced for value and may include visible wear that could need cleaning or extra attention.</div></details>\n    <details><summary>Can I request &ldquo;no stains&rdquo; or &ldquo;no holes&rdquo;?</summary><div class=\"na-faq-body\">We can&rsquo;t guarantee zero imperfections with vintage, but choosing <strong>A Grade</strong> significantly reduces the chance of noticeable flaws.</div></details>\n    <details><summary>Do you grade based on brand or trend value?</summary><div class=\"na-faq-body\">No &mdash; we grade purely on <strong>condition and wearability</strong>. That keeps grading consistent and objective across every bundle.</div></details>\n    <details><summary>What does a blended grade (A/B or B/C) mean?</summary><div class=\"na-faq-body\">Blended grades contain a mix of two adjacent grades.<br><br>For example:<ul><li><strong>A/B Grade</strong> = a mix of A Grade and B Grade items</li><li><strong>B/C Grade</strong> = a mix of B Grade and C Grade items</li></ul>You can expect <strong>roughly a 50/50 split</strong> between the two grades across the bundle.</div></details>\n    <details><summary>Why do blended grades exist?</summary><div class=\"na-faq-body\">Vintage stock naturally sits on a condition spectrum. Some items fall between grades and don&rsquo;t fit cleanly into a single category.<br><br>Blended grades allow us to:<ul><li>Grade honestly rather than forcing items into the wrong tier</li><li>Offer better value on borderline stock</li><li>Keep grading fair and consistent across large volumes</li></ul>This approach benefits volume buyers and resellers who understand vintage condition variation.</div></details>\n    <details><summary>Is the split always exactly 50/50?</summary><div class=\"na-faq-body\">While we aim for an even split, blended bundles may vary slightly depending on available stock.<br><br>You should expect the bundle to <strong>clearly reflect both grades overall</strong>, rather than leaning heavily toward one side.</div></details>\n    <details><summary>What if an item feels misgraded?</summary><div class=\"na-faq-body\">All items are graded by hand, by humans &mdash; not machines.<br><br>While we work hard to stay consistent, a small margin of error is unavoidable with vintage.<br><br>Please allow for a <strong>~10% grading variance</strong> across any bundle. This means a small number of items may sit slightly above or below the stated grade.<br><br>If something is clearly outside expectations, reach out &mdash; we&rsquo;ll always review it fairly.</div></details>\n  </section>\n\n  <section class=\"na-section\" id=\"grading-contact\">\n    <div class=\"na-contact-box\">\n      <h3>Still have questions?</h3>\n      <p>If you&rsquo;re unsure which grade is right for you, or need clarification on anything, our team is happy to help.</p>\n      <p class=\"na-contact-email\">Contact us at <a href=\"mailto:support@notanotherwholesale.com\">support@notanotherwholesale.com</a></p>\n    </div>\n  </section>\n\n</div>\n\n<style>\n  .na-grading-page, .na-grading-page *, .na-section, .na-section *, .na-contact-box, .na-contact-box *{font-family:'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;}\n  .na-grading-page .na-page-header{max-width:1100px;margin:3.2rem auto 2.2rem;padding:0 2rem;text-align:center}\n  .na-grading-page .na-page-header h1{font-size:5rem;font-weight:900;letter-spacing:0.04em;text-transform:uppercase;line-height:1.05;margin:0 0 .7rem;color:#111;text-wrap:balance}\n  .na-grading-page .na-page-subtitle{font-size:1.05rem;line-height:1.7;color:#555;max-width:720px;margin:0 auto}\n  .na-grading-page .na-divider{width:56px;height:3px;background:#111;margin:1.4rem auto 0;border-radius:999px}\n  .na-grading-page .na-grade-intro-wrap{max-width:980px;margin:0 auto 2.2rem;padding:0 2rem}\n  .na-grading-page .na-grade-intro{background:#f6f6f6;border:1px solid rgba(17,17,17,.08);border-radius:22px;padding:1.6rem 1.75rem;text-align:center}\n  .na-grading-page .na-grade-intro p{margin:0;color:#333;line-height:1.8;font-size:1.02rem}\n  .na-grading-page .na-grade-intro-lead{font-weight:800;color:#111}\n  .na-grading-page .na-grade-intro strong{font-weight:900;color:#111}\n  .na-grading-page .na-scroll-cue{margin-top:1rem;font-size:.92rem;color:#777;letter-spacing:.02em}\n  .na-grading-page .na-grade-grid{max-width:1400px;margin:2.2rem auto 3.6rem;padding:0 2rem;display:grid;grid-template-columns:repeat(3,1fr);gap:22px}\n  .na-grading-page .na-grade-card{border:1px solid rgba(17,17,17,.12);border-radius:20px;padding:22px 22px 20px;background:#fff;box-shadow:0 8px 24px rgba(0,0,0,.04);transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}\n  .na-grading-page .na-grade-card:hover{transform:translateY(-2px);border-color:rgba(17,17,17,.20);box-shadow:0 14px 34px rgba(0,0,0,.08)}\n  .na-grading-page .na-grade-pill{display:inline-flex;align-items:center;gap:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;border:1px solid rgba(17,17,17,.22);border-radius:999px;padding:8px 14px;margin-bottom:12px;font-size:.78rem;color:#111;background:rgba(17,17,17,.03)}\n  .na-grading-page .na-grade-summary{margin:0 0 1rem;font-size:1rem;color:#555;line-height:1.65}\n  .na-grading-page .na-grade-card ul{margin:0;padding-left:18px;font-size:.96rem;line-height:1.7;color:#333}\n  .na-grading-page .na-grade-card li{margin:.38rem 0}\n  @media (max-width:768px){\n    .na-grading-page .na-page-header{max-width:100%;padding:0 1.25rem;margin:2.2rem auto 1.6rem}\n    .na-grading-page .na-page-header h1{font-size:2.35rem;letter-spacing:.03em}\n    .na-grading-page .na-page-subtitle{font-size:1.05rem;max-width:52ch}\n    .na-grading-page .na-divider{width:44px;height:2px}\n    .na-grading-page .na-grade-intro-wrap{padding:0 1.25rem;margin-bottom:1.4rem}\n    .na-grading-page .na-grade-intro{padding:1.25rem 1.15rem;border-radius:18px}\n    .na-grading-page .na-grade-intro p{font-size:1rem}\n    .na-grading-page .na-grade-grid{grid-template-columns:1fr;padding:0 1.25rem;gap:16px;margin:1.6rem auto 2.6rem}\n  }\n  .na-section{max-width:1200px;margin:0 auto;padding:0 2rem}\n  .na-section + .na-section{margin-top:3rem}\n  .na-section-title{text-align:center;margin:0 0 .6rem;font-weight:900;text-transform:uppercase;letter-spacing:.04em;color:#111;font-size:1.6rem}\n  .na-section-subtitle{text-align:center;margin:0 auto 1.6rem;max-width:70ch;color:#555;line-height:1.7;font-size:1.02rem}\n  .na-criteria-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin:1.6rem 0 0}\n  .na-criteria-item{border:1px solid rgba(17,17,17,.10);background:#fff;border-radius:16px;padding:14px 14px 12px;box-shadow:0 10px 26px rgba(0,0,0,.04)}\n  .na-criteria-label{display:block;font-weight:900;letter-spacing:.04em;text-transform:uppercase;color:#111;font-size:.78rem;margin-bottom:.35rem}\n  .na-criteria-desc{margin:0;color:#555;font-size:.95rem;line-height:1.6}\n  .na-accordion-wrap{margin-top:2.4rem}\n  .na-accordion{border:1px solid rgba(17,17,17,.12);border-radius:18px;background:#fff;box-shadow:0 12px 30px rgba(0,0,0,.05);overflow:hidden}\n  .na-accordion + .na-accordion{margin-top:14px}\n  .na-accordion summary{list-style:none;cursor:pointer;padding:18px 18px 16px;display:flex;gap:14px;align-items:center;justify-content:space-between}\n  .na-accordion summary::-webkit-details-marker{display:none}\n  .na-acc-left{display:flex;flex-direction:column;gap:6px}\n  .na-acc-topline{display:flex;align-items:center;gap:10px;flex-wrap:wrap}\n  .na-pill{display:inline-flex;align-items:center;border-radius:999px;padding:7px 12px;border:1px solid rgba(17,17,17,.22);background:rgba(17,17,17,.03);font-weight:900;letter-spacing:.08em;text-transform:uppercase;font-size:.78rem;color:#111}\n  .na-acc-title{font-weight:900;color:#111;font-size:1.05rem;margin:0}\n  .na-acc-snippet{margin:0;color:#555;font-size:.98rem;line-height:1.6;max-width:78ch}\n  .na-chevron{width:34px;height:34px;border-radius:999px;border:1px solid rgba(17,17,17,.16);display:grid;place-items:center;flex:0 0 auto;transition:transform .18s ease,background .18s ease,border-color .18s ease;background:#fff}\n  .na-chevron svg{width:18px;height:18px;display:block}\n  .na-accordion[open] .na-chevron{transform:rotate(180deg);background:rgba(17,17,17,.03);border-color:rgba(17,17,17,.22)}\n  .na-acc-body{padding:0 18px 18px}\n  .na-acc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:10px}\n  .na-acc-box{border:1px solid rgba(17,17,17,.10);border-radius:16px;padding:14px 14px 12px;background:#fafafa}\n  .na-acc-box h4{margin:0 0 .5rem;font-weight:900;letter-spacing:.03em;color:#111;font-size:.95rem;text-transform:uppercase}\n  .na-acc-box ul{margin:0;padding-left:18px;color:#333;font-size:.96rem;line-height:1.7}\n  .na-acc-box li{margin:.35rem 0}\n  .na-acc-note{margin:14px 0 0;color:#555;line-height:1.7;font-size:.98rem}\n  .na-picker{margin-top:1.8rem;border:1px solid rgba(17,17,17,.10);border-radius:22px;padding:18px;background:#f6f6f6}\n  .na-picker-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}\n  .na-picker-item{background:#fff;border:1px solid rgba(17,17,17,.10);border-radius:18px;padding:14px;box-shadow:0 10px 24px rgba(0,0,0,.04)}\n  .na-picker-item h4{margin:0 0 .5rem;font-weight:900;text-transform:uppercase;letter-spacing:.04em;font-size:.9rem;color:#111}\n  .na-picker-item p{margin:0;color:#555;line-height:1.65;font-size:.98rem}\n  .na-faq{margin-top:2.2rem}\n  .na-faq details{border:1px solid rgba(17,17,17,.12);border-radius:18px;background:#fff;box-shadow:0 12px 30px rgba(0,0,0,.05);overflow:hidden}\n  .na-faq details + details{margin-top:12px}\n  .na-faq summary{list-style:none;cursor:pointer;padding:16px 18px;font-weight:900;color:#111}\n  .na-faq summary::-webkit-details-marker{display:none}\n  .na-faq .na-faq-body{padding:0 18px 16px;color:#555;line-height:1.75;font-size:.98rem}\n  .na-contact-box{max-width:820px;margin:2.5rem auto 3.5rem;padding:1.6rem 1.8rem;text-align:center;background:#f6f6f6;border:1px solid rgba(17,17,17,.08);border-radius:22px}\n  .na-contact-box h3{margin:0 0 .5rem;font-size:1.25rem;font-weight:900;color:#111}\n  .na-contact-box p{margin:0.35rem 0;color:#555;line-height:1.7;font-size:1rem}\n  .na-contact-email{margin-top:.6rem;font-weight:700}\n  .na-contact-email a{color:#111;text-decoration:underline;text-underline-offset:3px}\n  @media (max-width:980px){.na-criteria-grid{grid-template-columns:repeat(2,1fr)}.na-acc-grid{grid-template-columns:1fr}.na-picker-grid{grid-template-columns:1fr}}\n  @media (max-width:768px){.na-section{padding:0 1.25rem}.na-section-title{font-size:1.35rem}.na-section-subtitle{font-size:1rem;margin-bottom:1.2rem}.na-criteria-grid{gap:10px}.na-accordion summary{padding:16px 14px 14px}.na-acc-body{padding:0 14px 14px}.na-contact-box{margin:2rem 1.25rem 2.8rem;padding:1.3rem 1.25rem}.na-contact-box h3{font-size:1.15rem}}\n</style>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    }
  },
