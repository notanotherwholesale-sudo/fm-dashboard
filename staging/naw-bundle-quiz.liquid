      h+='<div class="nbq-math"><div><b>£'+m.pr+'</b><span>bale</span></div><div><b>'+m.kg+'kg</b><span>straight in</span></div><div><b>£'+(m.pr/m.kg).toFixed(1)+'</b><span>per kg</span></div></div>';
    }else{
      h+='<div class="nbq-math"><div><b>£'+m.pr+'</b><span>bundle</span></div>'
        +(m.pc?'<div><b>'+m.pc+'</b><span>pieces</span></div><div><b>£'+(m.pr/m.pc).toFixed(2).replace(/\.00$/,'')+'</b><span>per piece</span></div>':'')
        +(m.g?'<div><b>'+m.g+'</b><span>grade</span></div>':'')+'</div>';
    }
    h+='<div class="nbq-ctarow"><a class="nbq-cta" href="/products/'+m.h+'">Shop this bundle</a>'
      +'<button class="nbq-cta nbq-atcbtn" data-atc="'+pkey(m)+'" aria-label="Add to cart"><span class="atxt">Add to cart</span><span class="aic"><svg viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg><i>+</i></span></button>'
      +'<button class="nbq-cta2" data-addmain="'+pkey(m)+'" title="Add to stack">+</button></div>'
      +'<p class="nbq-dispatch">Order before <b>11am</b> for same-day dispatch</p></div>';
    // auto-seed the stack only when the budget clears £300 — below that the panel
    // stays available but empty (their build, their call)
    var stack=(win()[1]>=300)?buildStack():null;
    if(stack&&(!m.pc||stack.pc>=m.pc*1.5))stackSel=stack.items.map(pkey);
    if(picks.length>1){
      // gold RECOMMENDED nudge: max two ≥90% tiles get the highlight
      var hlLeft=2;
      h+='<div class="nbq-altk">Ranked close behind — tap + to stack</div><div class="nbq-alts">';
      picks.slice(1,13).forEach(function(x,ai){
        var a=x.p;
        var hl=x.pct>=90&&hlLeft>0;if(hl)hlLeft--;
        h+='<div class="nbq-alt'+(hl?' nbq-recd':'')+(ai>=6?' nbq-more':'')+'" data-h="'+pkey(a)+'" role="button" tabindex="0" style="animation-delay:'+(ai%6*50)+'ms">'
          +(hl?'<span class="nbq-recstar" title="Recommended"><svg viewBox="0 0 24 24"><path d="m12 3 2.6 5.3 5.9.8-4.3 4.1 1 5.8L12 16.3 6.8 19l1-5.8-4.3-4.1 5.9-.8L12 3Z"/></svg></span>':'')
          +'<span class="ph"><img src="'+a.img+'" alt="" loading="lazy"></span>'
          +'<span class="add"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span>'
          +'<span class="apc">'+x.pct+'%</span>'
          +'<span class="tx">'+a.n+'<em>'+(a.kg?a.kg+'kg':a.pc+' pc')+' · £'+a.pr+(a.g?' · '+a.g:'')+'</em></span>'
          +'<span class="trow"><a class="view" href="/products/'+a.h+'">View →</a>'
          +'<button class="tatc" data-atc="'+pkey(a)+'" aria-label="Add to cart"><svg viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg><i>+</i></button></span></div>';
      });
      h+='</div>';
      if(picks.length>7)h+='<button class="nbq-cta2 nbq-viewmore" data-viewmore>View '+(picks.length-7)+' more</button>';
    }
    h+='<div class="nbq-altk">Stack the budget — build one order</div><div class="nbq-stack" id="nbqstack"></div>';
    h+=mailPanelHtml();
    h+='<button class="nbq-restart">Retake the quiz</button>';
    resultShell(h);
    renderStackPanel();
    wireMailPanel(picks);
    [].slice.call(stage.querySelectorAll('[data-h]')).forEach(function(c){
      c.classList.toggle('instack',stackSel.indexOf(c.getAttribute('data-h'))>-1);
      c.addEventListener('click',function(e){
        if(e.target.closest('.view'))return;
        toggleStack(c.getAttribute('data-h'));
      });
      c.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();toggleStack(c.getAttribute('data-h'));}});
    });
    var addMain=stage.querySelector('[data-addmain]');
    if(addMain)addMain.addEventListener('click',function(){toggleStack(addMain.getAttribute('data-addmain'));});
    [].slice.call(stage.querySelectorAll('[data-atc]')).forEach(function(b){
      b.addEventListener('click',function(e){e.stopPropagation();addOneToCart(b.getAttribute('data-atc'),b);});
    });
    var vm=stage.querySelector('[data-viewmore]');
    if(vm)vm.addEventListener('click',function(){
      [].slice.call(stage.querySelectorAll('.nbq-more')).forEach(function(x){x.classList.remove('nbq-more');});
      vm.remove();track('Viewed More');
    });
  }
  function renderStackOnly(stack){
    stackSel=stack.items.map(pkey);
    var h='<div class="nbq-kick2">No single bundle reaches '+budLabel()+'</div>'
      +'<h2 class="nbq-rt">So we built you a stack.</h2>'
      +'<p class="nbq-s">'+stack.items.length+' bundles from '+ans.styles.map(function(s){return LANES[s];}).join(' + ')+', one order, inside your range.</p>'
      +'<div class="nbq-stack" id="nbqstack"></div>'
      +mailPanelHtml()
      +'<button class="nbq-restart">Retake the quiz</button>';
    resultShell(h);
    renderStackPanel();
    wireMailPanel(stack.items.map(function(p){return{p:p,pct:Math.max(62,Math.min(99,Math.round(score(p)/109*100)))};}));
  }
  function renderEmpty(){
    track('Empty Result',{platform:ans.platform,budget_min:ans.bmin,budget_max:ans.bmax,lanes:ans.styles.join(','),goal:ans.goal});
    var lbl=ans.styles.map(function(s){return LANES[s];}).join(' + ');
    var h='<div class="nbq-kick2">Straight answer</div>'
      +'<h2 class="nbq-rt">Nothing in '+lbl+' fits '+budLabel()+' today.</h2>'
      +'<p class="nbq-s">We would rather tell you that than pad the list with stock that is not what you asked for. Step the budget up or down, or pick another lane — the pool refills on every restock.</p>'
      +'<button class="nbq-cta" data-retry>Change my answers</button>'
      +'<button class="nbq-restart">Start over</button>';
    resultShell(h);
    stage.querySelector('[data-retry]').addEventListener('click',function(){step=3;renderStep();});
  }

  /* email my shortlist → Klaviyo client event "NAW Quiz: Picks Saved" with the
     picks payload the flow template renders; identified profile = flow triggers */
  var KLAVIYO_COMPANY='SHDKyV';
  function mailPicksPayload(list){
    return list.slice(0,6).map(function(x){
      var p=x.p||x;
      return {name:p.n,img:p.img,url:location.origin+'/products/'+p.h,
        pieces:p.kg?p.kg+'kg':(p.pc?p.pc+' pc':''),price:'£'+p.pr,grade:p.g||'',
        match:x.pct?x.pct+'%':''};
    });
  }
  function mailPanelHtml(){
    return '<div class="nbq-mail" id="nbqmail"><p class="nbq-mailk">Save this shortlist</p>'
      +'<h3 class="nbq-mailt">Email me my picks.</h3>'
      +'<p class="nbq-mails">We’ll send this exact shortlist to your inbox so you can come back to it — plus a heads-up if any of it starts selling out.</p>'
      +'<form class="nbq-mailrow" data-mailform novalidate>'
      +'<input class="nbq-mailin" type="email" name="email" autocomplete="email" placeholder="you@yourshop.com" aria-label="Email address">'
      +'<button class="nbq-mailbtn" type="submit">Send my picks</button></form>'
      +'<p class="nbq-mailerr" data-mailerr>That email doesn’t look right — check it and try again.</p>'
      +'<p class="nbq-mailfine">Your results now, a reminder if your picks start selling out, plus first look at new drops. Unsubscribe anytime.</p></div>';
  }
  function wireMailPanel(list){
    var box=document.getElementById('nbqmail');if(!box)return;
    var form=box.querySelector('[data-mailform]');
    form.addEventListener('submit',function(e){
      e.preventDefault();
      var input=box.querySelector('.nbq-mailin'),err=box.querySelector('[data-mailerr]'),
        btn=box.querySelector('.nbq-mailbtn'),email=(input.value||'').trim();
      if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)){err.style.display='block';input.focus();return;}
      err.style.display='none';btn.setAttribute('disabled','');btn.textContent='Sending…';
      var props={platform:PLATS[ans.platform]||ans.platform||'',budget:budLabel(),
        lanes:ans.styles.map(function(s){return LANES[s]||s;}).join(', '),
        goal:GOALS[ans.goal]||ans.goal||'',picks:mailPicksPayload(list),
        tool:'naw-bundle-quiz'};
      fetch('https://a.klaviyo.com/client/events/?company_id='+KLAVIYO_COMPANY,{
        method:'POST',
        headers:{'Content-Type':'application/json','revision':'2024-10-15'},
        body:JSON.stringify({data:{type:'event',attributes:{
          properties:props,
          metric:{data:{type:'metric',attributes:{name:'NAW Quiz: Picks Saved'}}},
          profile:{data:{type:'profile',attributes:{email:email}}}
        }}})
      }).then(function(r){
        if(!r.ok)throw new Error('klaviyo '+r.status);
        // also join the general Email List (campaign reach; no flow hangs off this
        // list so no welcome emails) — fire-and-forget, never blocks the UX
        fetch('https://a.klaviyo.com/client/subscriptions/?company_id='+KLAVIYO_COMPANY,{
          method:'POST',
          headers:{'Content-Type':'application/json','revision':'2024-10-15'},
          body:JSON.stringify({data:{type:'subscription',attributes:{
            custom_source:'NAW Bundle Quiz',
            profile:{data:{type:'profile',attributes:{email:email}}}
          },relationships:{list:{data:{type:'list',id:'QYrnhF'}}}}})
        }).catch(function(){});
        try{
          if(window.klaviyo&&window.klaviyo.identify)window.klaviyo.identify({email:email});
          else if(window._learnq&&window._learnq.push)window._learnq.push(['identify',{$email:email}]);
        }catch(e){}
        track('Picks Emailed',{results:list.length});
        box.innerHTML='<div class="nbq-maildone"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>'
          +'<div><b>On its way.</b><span>Your picks are heading to '+email.replace(/</g,'&lt;')+' — give it a couple of minutes.</span></div></div>';
      }).catch(function(){
        btn.removeAttribute('disabled');btn.textContent='Send my picks';
        err.textContent='Something went wrong sending that — try again in a second.';err.style.display='block';
      });
    });
  }

  /* every use tracked: Klaviyo events (extract via API) + GA dataLayer + order
     attributes on checkout — answers become buying-intel */
  function track(ev,props){
    try{
      props=props||{};props.tool='naw-bundle-quiz';
      if(window.klaviyo&&window.klaviyo.push)window.klaviyo.push(['track','NAW Quiz: '+ev,props]);
      else if(window._learnq&&window._learnq.push)window._learnq.push(['track','NAW Quiz: '+ev,props]);
      var slug='naw_quiz_'+ev.toLowerCase().replace(/[^a-z]+/g,'_');
      window.dataLayer=window.dataLayer||[];
      window.dataLayer.push(Object.assign({event:slug},props));
      // GA4 direct: the site runs plain gtag (no GTM), and Klaviyo drops
      // anonymous visitors' custom events — gtag is the reliable sink
      if(typeof window.gtag==='function')window.gtag('event',slug,props);
    }catch(e){}
  }
  var hlEl=root.querySelector('.nbq-hl');
  if(hlEl){
    var wds=hlEl.textContent.trim().split(/\s+/);
    if(wds.length>2){
      var best=1,diff=1e9;
      for(var bi=1;bi<wds.length;bi++){
        var d=Math.abs(wds.slice(0,bi).join(' ').length-wds.slice(bi).join(' ').length);
        if(d<diff){diff=d;best=bi;}
      }
      hlEl.textContent=wds.slice(0,best).join('\u00A0')+' '+wds.slice(best).join('\u00A0');
    }
  }
  var shell=root.querySelector('.nbq-shell');
  stage.hidden=false;
  stage.classList.add('pre');
  var PIC={
    sell:'<path d="M3 9.5 4.5 4h15L21 9.5M4.5 9.5V20h15V9.5M9.5 20v-5.5h5V20"/><path d="M3 9.5h18"/>',
    budget:'<path d="M4 8h16M4 16h16"/><circle cx="9.5" cy="8" r="2.4"/><circle cx="14.5" cy="16" r="2.4"/>',
    lane:'<rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/>',
    win:'<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4.4"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/>'
  };
  stage.innerHTML='<div class="nbq-pre"><p class="nbq-prek">How it works</p>'
    +[['sell','Select your platform','Depop, Vinted, eBay, live or in person'],
      ['budget','Enter your budget','Use our pricing range'],
      ['lane','Find your niche','Select up to 3 categories'],
      ['win','Lock in the objective','Premium, sell-through, margin or volume']]
      .map(function(r,i){return '<div class="nbq-prerow"><span class="nbq-pren"><svg viewBox="0 0 24 24">'+PIC[r[0]]+'</svg></span><span><b>'+r[1]+'</b><em>'+r[2]+'</em></span></div>';}).join('')
    +'<p class="nbq-prefoot">Scored against live stock the second you start — nothing pre-baked, nothing out of stock.</p></div>';
  // gentle life: step through the four rows unless the visitor is hovering or prefers stillness
  if(!matchMedia('(prefers-reduced-motion: reduce)').matches){
    var pRows=[].slice.call(stage.querySelectorAll('.nbq-prerow')),pi=0,pHover=false;
    pRows.forEach(function(r){
      r.addEventListener('mouseenter',function(){pHover=true;pRows.forEach(function(x){x.classList.remove('on');});r.classList.add('on');});
      r.addEventListener('mouseleave',function(){pHover=false;r.classList.remove('on');});
    });
    var pT=setInterval(function(){
      if(!stage.querySelector('.nbq-pre')){clearInterval(pT);return;}
      if(pHover)return;
      pRows.forEach(function(x){x.classList.remove('on');});
      pRows[pi%4].classList.add('on');pi++;
    },1800);
  }
  // resume: restore a saved run (≤48h) instead of restarting
  function savedState(){
    try{
      var s=JSON.parse(localStorage.getItem('nawQuizSaved')||'null');
      if(s&&s.ans&&s.ts&&(Date.now()-s.ts)<48*3600*1000)return s;
    }catch(e){}
    return null;
  }
  function resume(){
    var s=savedState();if(!s)return false;
    ans=s.ans;shell.classList.add('started');
    stage.hidden=false;stage.classList.remove('pre');
    stage.innerHTML='<div class="nbq-skel"><i></i><i></i><i></i><p>Checking live stock</p></div>';
    (CAT?Promise.resolve():buildCatalog()).then(function(){renderResult();});
    track('Resumed');
    return true;
  }
  if(savedState()){
    var rb=document.createElement('button');
    rb.className='nbq-resume';rb.type='button';
    rb.innerHTML='Pick up where you left off <span>→</span>';
    root.querySelector('.nbq-ibody').insertBefore(rb,root.querySelector('[data-nbq-start]'));
    rb.addEventListener('click',resume);
  }
  if(/[?&]quiz=resume/.test(location.search))setTimeout(function(){resume();},50);
  // slim collection-page teaser hand-off: ?qp=<platform> skips straight to step 2
  var qp=(location.search.match(/[?&]qp=(\w+)/)||[])[1];
  if(qp&&['depop','vinted','ebay','live','person'].indexOf(qp)>-1&&!/[?&]quiz=resume/.test(location.search)){
    setTimeout(function(){
      ans.platform=qp;step=1;
      shell.classList.add('started');stage.hidden=false;stage.classList.remove('pre');
      stage.innerHTML='<div class="nbq-skel"><i></i><i></i><i></i><p>Checking live stock</p></div>';
      track('Started',{src:'collection-teaser',platform:qp});
      (CAT?Promise.resolve():buildCatalog()).then(function(){renderStep();});
    },60);
  }
  root.querySelector('[data-nbq-start]').addEventListener('click',function(){
    shell.classList.add('started');
    stage.classList.remove('pre');
    stage.innerHTML='<div class="nbq-skel"><i></i><i></i><i></i><p>Checking live stock</p></div>';
    track('Started');
    if(window.innerWidth<990)stage.scrollIntoView({behavior:'smooth',block:'start'});
    (CAT?Promise.resolve():buildCatalog()).then(function(){renderStep();});
  });
})();
</script>

{% schema %}
{
  "name": "NAW Bundle quiz",
  "settings": [
    {"type": "text", "id": "kicker", "label": "Kicker", "default": "FOUR TAPS · TWENTY SECONDS"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Stuck on what to buy?"},
    {"type": "text", "id": "subheading", "label": "Subheading", "default": "Four quick questions. We score every in-stock bundle against your platform, budget and niche — then showcase the ones worth buying."},
    {"type": "text", "id": "cta_label", "label": "Button label", "default": "Take the quiz"},
    {"type": "image_picker", "id": "hero_image", "label": "Hero image (optional — defaults to warehouse shot)"},
    {"type": "header", "content": "Lane collections (comma-separated handles)"},
    {"type": "text", "id": "lane_work", "label": "Workwear", "default": "workwear"},
    {"type": "text", "id": "lane_sport", "label": "Sportswear", "default": "sportswear"},
    {"type": "text", "id": "lane_legwear", "label": "Legwear", "default": "trousers,shorts"},
    {"type": "text", "id": "lane_graphics", "label": "Graphics", "default": "t-shirts"},
    {"type": "text", "id": "lane_outdoors", "label": "Outdoors", "default": "jackets,knitwear"},
    {"type": "text", "id": "lane_premium", "label": "Premium", "default": "premium"},
    {"type": "text", "id": "seasonal_summer", "label": "Seasonal (Apr–Sep)", "default": "spring-summer"},
    {"type": "text", "id": "seasonal_winter", "label": "Seasonal (Oct–Mar)", "default": "autumn-collection"},
    {"type": "text", "id": "lane_any", "label": "Generalist boxes & bales", "default": "mixed-category,reseller-bundles,bales"}
  ],
  "presets": [{"name": "NAW Bundle quiz"}]
}
{% endschema %}
