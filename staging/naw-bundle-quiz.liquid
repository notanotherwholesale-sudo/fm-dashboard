    h+='<div class="nbq-recap"><span><b>'+PLATS[ans.platform]+'</b></span>'
      +ans.styles.map(function(st){return '<span><b>'+LANES[st]+'</b></span>';}).join('')
      +'<span><b>'+GOALS[ans.goal]+'</b></span><span><b>'+budLabel()+'</b></span></div>';
    h+='<div class="nbq-rec"><div class="nbq-heroimg"><span class="nbq-match">'+picks[0].pct+'% MATCH</span>'
      +'<span class="nbq-stockc">IN STOCK</span><img src="'+m.img+'" alt="'+m.n+'"></div>';
